[project]
name       = ADAM
version    = VERSION
summary    = Accelerated fluid Dynamics on Adaptive Mesh refinement grids
repository = https://github.com/szaghi/adam
website    = https://szaghi.github.io/adam
email      = stefano.zaghi@gmail.it
authors    = "Andrea Di Mascio" "Federico Negro" "Giacomo Rossi" "Francesco Salvadore" "Stefano Zaghi"

[dependencies]
deps_dir   = src/third_party
BeFoR64    = https://github.com/szaghi/BeFoR64
FACE       = https://github.com/szaghi/FACE
FiNeR      = https://github.com/szaghi/FiNeR
FUNDAL     = https://github.com/szaghi/FUNDAL
FOSSIL     = https://github.com/szaghi/FOSSIL
FoXy       = https://github.com/Fortran-FOSS-Programmers/FoXy
MORTIF     = https://github.com/szaghi/MORTIF
MOTIOn     = https://github.com/szaghi/MOTIOn
PENF       = https://github.com/szaghi/PENF
StringiFor = https://github.com/szaghi/StringiFor
VTKFortran = https://github.com/szaghi/VTKFortran
VecFor     = https://github.com/szaghi/VecFor

[modes]
modes = ascot-nvf-cuda
        adam-com-gnu                          adam-com-gnu-debug
        adam-com-nvf                          adam-com-nvf-debug
        adam-nvf-cuda                         adam-nvf-cuda-debug
        nasto-fnl-nvf-oac                     nasto-fnl-nvf-oac-debug
        nasto-nvf-cuda                        nasto-nvf-cuda-debug
        nasto-cpu-gnu
        nasto-cpu-gnu-github
        prism-gnu                             prism-gnu-debug
        prism-fnl-nvf-oac                     prism-fnl-nvf-oac-debug
        prism-fnl-nvf-oac-leonardo            prism-fnl-nvf-oac-leonardo-debug
        chase-gnu                             chase-gnu-debug
        patch-gnu                             patch-gnu-debug
        test-fdv-curl-trigonometric-gnu       test-fdv-curl-trigonometric-gnu-debug
        test-fdv-fnl-curl-trigonometric-nvf-oac
        test-fdv-fnl-operators-trigonometric-nvf-oac
        test-fdv-divergence-trigonometric-gnu test-fdv-divergence-trigonometric-gnu-debug
        test-fdv-gradient-trigonometric-gnu   test-fdv-gradient-trigonometric-gnu-debug
        test-fdv-laplacian-trigonometric-gnu  test-fdv-laplacian-trigonometric-gnu-debug
        test-fdv-operators-step-gnu           test-fdv-operators-step-gnu-debug
        test-fdv-operators-trigonometric-gnu  test-fdv-operators-trigonometric-gnu-debug

# main modes

# ascot
[ascot-nvf-cuda]
help     = Build ASCOT app with NVF CUDA compiler
template = template-nvf-cuda
target   = ascot.F90
preproc  = -D_NVF

# adam libraries
# GNU
[adam-com-gnu]
help     = Build ADAM common library with GNU compiler
template = template-gnu
target   = adam_common_library.F90
output   = libadamcommon_gnu.a
mklib    = static
preproc  = -D_MPI_

[adam-com-gnu-debug]
help     = Build ADAM common library with GNU compiler, debug mode
template = template-gnu-debug
target   = adam_common_library.F90
output   = libadamcommon_gnu.a
mklib    = static
preproc  = -D_MPI_

# NVF
[adam-com-nvf]
help     = Build ADAM common library with NVF compiler
template = template-nvf
target   = adam_common_library.F90
output   = libadamcommon_nvf.a
mklib    = static
preproc  = -D_MPI_

[adam-com-nvf-debug]
help     = Build ADAM common library with NVF compiler, debug mode
template = template-nvf-debug
target   = adam_common_library.F90
output   = libadamcommon_nvf.a
mklib    = static
preproc  = -D_MPI_

[adam-nvf-cuda]
help     = Build ADAM NVF library with NVF CUDA compiler
template = template-nvf-cuda
target   = adam_nvf_library.F90
output   = libadamnvf.a
mklib    = static
preproc  = -D_MPI_

[adam-nvf-cuda-debug]
help     = Build ADAM NVF library with NVF CUDA compiler, debug mode
template = template-nvf-cuda-debug
target   = adam_nvf_library.F90
output   = libadamnvf.a
mklib    = static
preproc  = -D_MPI_

# prism
[prism-gnu]
help     = Build PRISM app with GNU compiler
template = template-gnu
preproc  = -D_MPI_ -w
target   = adam_prism_cpu.F90

[prism-gnu-debug]
help     = Build PRISM app with GNU compiler, debug mode
template = template-gnu-debug
preproc  = -D_MPI_ -w
target   = adam_prism_cpu.F90

[prism-fnl-nvf-oac]
help     = Build PRISM app with FNL library and NVF OpenACC compiler
template = template-nvf-oac
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = adam_prism_fnl.F90

[prism-fnl-nvf-oac-debug]
help     = Build PRISM app with FNL library and NVF OpenACC compiler, debug mode
template = template-nvf-oac-debug-mod
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = adam_prism_fnl.F90

[prism-fnl-nvf-oac-leonardo]
help     = Build PRISM app with FNL library and NVF OpenACC compiler on CINECA Leonardo cluster
template = template-nvf-oac
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = adam_prism_fnl.F90
cflags   = -cpp -c -acc -gpu=cc80 -fast -Minfo=all
lflags   = -acc -gpu=cc80 -fast -Minfo=all
libs     = $HDF5_leonardo_nvf/lib/libhdf5_fortran.a $HDF5_leonardo_nvf/lib/libhdf5_f90cstub.a $HDF5_leonardo_nvf/lib/libhdf5.a
lib_dir  = $HDF5_leonardo_nvf/lib
include  = $HDF5_leonardo_nvf/include

[prism-fnl-nvf-oac-leonardo-debug]
help     = Build PRISM app with FNL library and NVF OpenACC compiler on CINECA Leonardo cluster
template = template-nvf-oac-debug
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = adam_prism_fnl.F90
cflags   = -cpp -c -acc -gpu=cc80 -fast -Minfo=all -C -gopt -Mbounds -traceback
lflags   = -acc -gpu=cc80 -fast -Minfo=all -C -gopt -Mbounds -traceback
libs     = $HDF5_leonardo_nvf/lib/libhdf5_fortran.a $HDF5_leonardo_nvf/lib/libhdf5_f90cstub.a $HDF5_leonardo_nvf/lib/libhdf5.a
lib_dir  = $HDF5_leonardo_nvf/lib
include  = $HDF5_leonardo_nvf/include

# chase
[chase-gnu]
help     = Build CHASE app with GNU compiler
template = template-gnu
preproc  = -D_MPI_ -w
target   = adam_chase_cpu.F90

[chase-gnu-debug]
help     = Build CHASE app with GNU compiler, debug mode
template = template-gnu-debug
preproc  = -D_MPI_ -w
target   = adam_chase_cpu.F90

# patch
[patch-gnu]
