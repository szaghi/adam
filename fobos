[modes]
modes = ascot-nvf-cuda-sz-ws
        adam-com-gnu-sz-ws      adam-com-gnu-sz-ws-debug
        adam-com-nvf-sz-ws      adam-com-nvf-sz-ws-debug
        adam-nvf-cuda-sz-ws     adam-nvf-cuda-sz-ws-debug
        nasto-fnl-nvf-oac-sz-ws nasto-fnl-nvf-oac-sz-ws-debug
        nasto-nvf-cuda-sz-ws    nasto-nvf-cuda-sz-ws-debug
        nasto-cpu-gnu-sz-ws
        prism-gnu-sz-ws

# main modes

# ascot
[ascot-nvf-cuda-sz-ws]
help     = Build ASCOT app with NVF CUDA compiler on SZ workstation
template = template-nvf-cuda-sz-ws
target   = ascot.F90
preproc  = -D_NVF

# adam libraries
# GNU
[adam-com-gnu-sz-ws]
help     = Build ADAM common library with GNU compiler on SZ workstation
template = template-gnu-sz-ws
target   = adam_common_library.F90
output   = libadamcommon_gnu.a
mklib    = static
preproc  = -D_MPI_

[adam-com-gnu-sz-ws-debug]
help     = Build ADAM common library with GNU compiler on SZ workstation, debug mode
template = template-gnu-sz-ws-debug
target   = adam_common_library.F90
output   = libadamcommon_gnu.a
mklib    = static
preproc  = -D_MPI_

# NVF
[adam-com-nvf-sz-ws]
help     = Build ADAM common library with NVF compiler on SZ workstation
template = template-nvf-sz-ws
target   = adam_common_library.F90
output   = libadamcommon_nvf.a
mklib    = static
preproc  = -D_MPI_

[adam-com-nvf-sz-ws-debug]
help     = Build ADAM common library with NVF compiler on SZ workstation, debug mode
template = template-nvf-sz-ws-debug
target   = adam_common_library.F90
output   = libadamcommon_nvf.a
mklib    = static
preproc  = -D_MPI_

[adam-nvf-cuda-sz-ws]
help     = Build ADAM NVF library with NVF CUDA compiler on SZ workstation
template = template-nvf-cuda-sz-ws
target   = adam_nvf_library.F90
output   = libadamnvf.a
mklib    = static
preproc  = -D_MPI_

[adam-nvf-cuda-sz-ws-debug]
help     = Build ADAM NVF library with NVF CUDA compiler on SZ workstation, debug mode
template = template-nvf-cuda-sz-ws-debug
target   = adam_nvf_library.F90
output   = libadamnvf.a
mklib    = static
preproc  = -D_MPI_

# prism
[prism-gnu-sz-ws]
help     = Build PRISM app with GNU compiler on SZ workstation
template = template-gnu-sz-ws
preproc  = -D_MPI_
target   = adam_prism_cpu.F90

#nasto
[nasto-fnl-nvf-oac-sz-ws]
help     = Build NASTO app with FNL library and NVF OpenACC compiler on SZ workstation
template = template-nvf-oac-sz-ws
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF
target   = adam_nasto_fnl.F90

[nasto-fnl-nvf-oac-sz-ws-debug]
help     = Build NASTO app with FNL library and NVF OpenACC compiler on SZ workstation, debug mode
template = template-nvf-oac-sz-ws-debug
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF
target   = adam_nasto_fnl.F90

[nasto-nvf-cuda-sz-ws]
help     = Build NASTO app with NVF CUDA compiler on SZ workstation
template = template-nvf-cuda-sz-ws
preproc  = -D_MPI_ -DCOMPILER_NVF -D_NVF
target   = adam_nasto_nvf.F90

[nasto-nvf-cuda-sz-ws-debug]
help     = Build NASTO app with NVF CUDA compiler on SZ workstation, debug mode
template = template-nvf-cuda-sz-ws-debug
preproc  = -D_MPI_ -DCOMPILER_NVF -D_NVF
target   = adam_nasto_nvf.F90

[nasto-cpu-gnu-sz-ws]
help     = Build NASTO app with CPU backend GNU compiler on SZ workstation
template = template-gnu-sz-ws
preproc  = -D_MPI_ -DCOMPILER_GNU
target   = adam_nasto_cpu.F90

# templates
[template-base]
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
build_dir    = ./exe/
colors       = True
quiet        = False
log          = True
jobs         = 4
mpi          = True
libs         = $GETMEMORY
ext_libs     = hdf5_fortran
exclude_dirs = src/lib_experimental/
               references/
               BeFoR64/src/tests/
               BeFoR64/src/third_party/
               FACE/src/tests/
               FACE/src/third_party/
               FiNeR/src/tests/
               FiNeR/src/third_party/
               FOSSIL/src/app/
               FOSSIL/src/tests/
               FOSSIL/src/third_party/
               FoXy/src/tests/
               FoXy/src/third_party/
               FUNDAL/src/tests/
               FUNDAL/src/third_party/
               MORTIF/src/tests/
               MORTIF/src/third_party/
               PENF/src/tests/
               StringiFor/src/tests/
               StringiFor/src/third_party/
               VecFor/src/tests/
               VecFor/src/third_party/
               VTKFortran/src/tests/
               VTKFortran/src/third_party/
               third_party_manual/

# NVF OpenACC
[template-nvf-oac-sz-ws]
template = template-base
compiler = nvfortran
cflags   = -cpp -c -acc -gpu=cc89 -fast -Minfo=all
lflags   = -acc -gpu=cc89 -fast -Minfo=all
lib_dir  = $HDF5_nvf_sz_ws/lib
include  = $HDF5_nvf_sz_ws/include

[template-nvf-oac-sz-ws-debug]
template = template-nvf-oac-sz-ws
cflags   = -cpp -c -acc -gpu=cc89 -Minfo=all -C -gopt -Mbounds -traceback
lflags   = -acc -gpu=cc89 -Minfo=all -C -gopt -Mbounds -traceback

# NVF CUDA Fortran
[template-nvf-cuda-sz-ws]
template = template-base
compiler = nvfortran
cflags   = -cpp -c -cuda -gpu=cc89,cuda12.8,ptxinfo -O2
lflags   = -cuda -gpu=cc89,cuda12.8,ptxinfo -O2
lib_dir  = $HDF5_nvf_sz_ws/lib
include  = $HDF5_nvf_sz_ws/include

[template-nvf-cuda-sz-ws-debug]
template = template-nvf-cuda-sz-ws
cflags   = -cpp -c -cuda -gpu=cc89,cuda12.8,ptxinfo -Minfo=all -C -gopt -traceback
lflags   = -cuda -gpu=cc89,cuda12.8,ptxinfo -Minfo=all -C -gopt -traceback

# NVF CPU
[template-nvf-sz-ws]
template = template-base
compiler = nvfortran
cflags   = -cpp -c -fast
lflags   = -fast
lib_dir  = $HDF5_nvf_sz_ws/lib
include  = $HDF5_nvf_sz_ws/include

[template-nvf-sz-ws-debug]
template = template-nvf-oac-sz-ws
cflags   = -cpp -c -C -gopt -Mbounds -traceback
lflags   = -acc -C -gopt -Mbounds -traceback

# GNU CPU
[template-gnu-sz-ws]
template = template-base
compiler = gnu
cflags   = -cpp -c -O2
lflags   = -O2
lib_dir  = $HDF5_gnu_sz_ws/lib
include  = $HDF5_gnu_sz_ws/include

[template-gnu-sz-ws-debug]
template = template-base
compiler = gnu
cflags   = -cpp -c -O0 -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -fcheck=all -fmodule-private -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan
lflags   = -O0 -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -fcheck=all -fmodule-private -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan
lib_dir  = $HDF5_gnu_sz_ws/lib
include  = $HDF5_gnu_sz_ws/include

# aux rules
[rule-makethirdpartymanual]
help   = Make third party manual-compiling libraries on SZ laptop
rule_1 = mkdir -p exe/mod exe/obj
rule_2 = cd src/third_party_manual/getmemory/ ; gcc -c getmemory.c ; cd -
rule_3 = mv src/third_party_manual/getmemory/*.o exe/obj/

[rule-makethirdpartymanual-leo]
help   = Make third party manual-compiling libraries on marconi100 cluster
rule_1 = mkdir -p exe/mod exe/obj
rule_2 = cd src/third_party_manual/getmemory/ ; gcc -c getmemory.c ; cd -
rule_3 = mv src/third_party_manual/getmemory/*.o exe/obj/

[rule-makethirdpartymanual-fl]
help   = Make third party manual-compiling libraries on marconi100 cluster
rule_1 = mkdir -p exe/mod exe/obj
rule_2 = cd src/third_party_manual/getmemory/ ; icx -c getmemory.c ; cd -
rule_3 = mv src/third_party_manual/getmemory/*.o exe/obj/

[rule-maketar]
help = Make tar archive of the project
rule = tar --xform="s%^%adam/%" -czf adam.tar.gz *

[rule-makedoc]
help   = Build documentation from source files
rule_1 = rm -rf doc/html/*
rule_2 = ford doc/main_page.md --debug
rule_3 = cp -r doc/html/publish/* doc/html/
rule_4 = rm -rf doc/html/publish

[rule-deldoc]
help = Delete documentation
rule = rm -rf doc/html/*

