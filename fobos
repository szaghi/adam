# templates
[template-base]
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
build_dir    = ./exe/
colors       = True
quiet        = False
log          = True
jobs         = 4
mpi          = True
ext_libs     = hdf5_fortran
exclude_dirs = src/lib_experimental/
               references/
               BeFoR64/src/tests/
               BeFoR64/src/third_party/
               FACE/src/tests/
               FACE/src/third_party/
               FiNeR/src/tests/
               FiNeR/src/third_party/
               FOSSIL/src/app/
               FOSSIL/src/tests/
               FOSSIL/src/third_party/
               FoXy/src/tests/
               FoXy/src/third_party/
               FUNDAL/src/tests/
               FUNDAL/src/third_party/
               FUNDAL/compilers_proofs/
               MORTIF/src/tests/
               MORTIF/src/third_party/
               MOTIOn/src/tests/
               MOTIOn/src/third_party/
               MOTIOn/lib
               PENF/src/tests/
               StringiFor/src/tests/
               StringiFor/src/third_party/
               VecFor/src/tests/
               VecFor/src/third_party/
               VTKFortran/src/tests/
               VTKFortran/src/third_party/
               third_party_manual/

# NVF OpenACC
[template-nvf-oac]
mod_dir  = ./mod/nvf/aoc/
obj_dir  = ./obj/nvf/aoc/
template = template-base
compiler = nvfortran
cflags   = -cpp -c -acc -gpu=cc89 -fast -Minfo=all
lflags   = -acc -gpu=cc89 -fast -Minfo=all
libs     = $HDF5_nvf/lib/libhdf5_fortran.a $HDF5_nvf/lib/libhdf5_f90cstub.a $HDF5_nvf/lib/libhdf5.a
lib_dir  = $HDF5_nvf/lib
include  = $HDF5_nvf/include
ext_libs = z

[template-nvf-oac-debug]
mod_dir  = ./mod/nvf/aoc/
obj_dir  = ./obj/nvf/aoc/
template = template-nvf-oac
cflags   = -cpp -c -acc -gpu=cc89 -Minfo=all -C -gopt -Mbounds -traceback -Mdetail -Mchkptr -Mchkstk -Ktrap=fp -g -O0
lflags   =         -acc -gpu=cc89 -Minfo=all -C -gopt -Mbounds -traceback -Mdetail -Mchkptr -Mchkstk -Ktrap=fp -g -O0

[template-nvf-oac-debug-mod]
mod_dir  = ./mod/nvf/aoc/
obj_dir  = ./obj/nvf/aoc/
template = template-nvf-oac
cflags   = -cpp -c -acc -gpu=cc89 -Minfo=all -C -gopt -Mbounds -traceback -Ktrap=fp -g -O0
lflags   =         -acc -gpu=cc89 -Minfo=all -C -gopt -Mbounds -traceback -Ktrap=fp -g -O0

# NVF CUDA Fortran
[template-nvf-cuda]
mod_dir  = ./mod/nvf/cuda/
obj_dir  = ./obj/nvf/cuda/
template = template-base
compiler = nvfortran
cflags   = -cpp -c -cuda -gpu=cc89,cuda12.8,ptxinfo -O2
lflags   = -cuda -gpu=cc89,cuda12.8,ptxinfo -O2
libs     = $HDF5_nvf/lib/libhdf5_fortran.a $HDF5_nvf/lib/libhdf5_f90cstub.a $HDF5_nvf/lib/libhdf5.a
lib_dir  = $HDF5_nvf/lib
include  = $HDF5_nvf/include

[template-nvf-cuda-debug]
mod_dir  = ./mod/nvf/cuda/
obj_dir  = ./obj/nvf/cuda/
template = template-nvf-cuda
cflags   = -cpp -c -cuda -gpu=cc89,cuda12.8,ptxinfo -Minfo=all -C -gopt -traceback
lflags   = -cuda -gpu=cc89,cuda12.8,ptxinfo -Minfo=all -C -gopt -traceback

# NVF CPU
[template-nvf]
mod_dir  = ./mod/nvf/
obj_dir  = ./obj/nvf/
template = template-base
compiler = nvfortran
cflags   = -cpp -c -fast
lflags   = -fast
libs     = $HDF5_nvf/lib/libhdf5_fortran.a $HDF5_nvf/lib/libhdf5_f90cstub.a $HDF5_nvf/lib/libhdf5.a
lib_dir  = $HDF5_nvf/lib
include  = $HDF5_nvf/include

[template-nvf-debug]
mod_dir  = ./mod/nvf/
obj_dir  = ./obj/nvf/
template = template-nvf
cflags   = -cpp -c -C -gopt -Mbounds -traceback
lflags   = -acc -C -gopt -Mbounds -traceback

# GNU CPU
[template-gnu]
mod_dir  = ./mod/gnu/
obj_dir  = ./obj/gnu/
template = template-base
compiler = gnu
cflags   = -cpp -c -O2
lflags   = -O2
libs     = $HDF5_gnu/lib/libhdf5_fortran.a $HDF5_gnu/lib/libhdf5_f90cstub.a $HDF5_gnu/lib/libhdf5.a
lib_dir  = $HDF5_gnu/lib
include  = $HDF5_gnu/include

[template-gnu-debug]
mod_dir  = ./mod/gnu/
obj_dir  = ./obj/gnu/
template = template-gnu
cflags   = -cpp -c -pg -O0 -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -fmodule-private -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan -fcheck=all -finit-real=snan -finit-integer=-2147483647 -finit-derived -ffpe-trap=invalid,zero,overflow
lflags   =         -pg -O0 -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -fmodule-private -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan -fcheck=all -finit-real=snan -finit-integer=-2147483647 -finit-derived -ffpe-trap=invalid,zero,overflow

# aux rules
[rule-hdf5-build-gnu]
help = Download HDF5 and build with GNU (openmpi/mpich)
rule = scripts/hdf5_build.sh -build

[rule-maketar]
help = Make tar archive of the project
rule = tar --xform="s%^%adam/%" -czf adam.tar.gz *

[rule-makedoc]
help   = Build documentation with formal + VitePress
rule_1 = formal generate --mirror-sources --diagrams --project docs/ford.md --output docs/api
rule_2 = cd docs && npm ci && npm run docs:build

[rule-delexe]
help = Delete exes
rule = rm -rf exe/

[rule-deldoc]
help = Delete documentation build artifacts
rule = rm -rf docs/.vitepress/dist/ docs/.vitepress/cache/ docs/api/

[rule-cleanall]
help   = Clean the project tree
rule_1 = FoBiS.py rule -ex deldoc
rule_2 = FoBiS.py rule -ex delexe
rule_3 = rm -f *.gcov

[rule-build-tests-fdv]
help   = Build FDV operators tests
rule_1 = FoBiS.py rule -ex delexe
rule_2 = FoBiS.py build -mode test-fdv-curl-trigonometric-gnu       -coverage
rule_3 = FoBiS.py build -mode test-fdv-divergence-trigonometric-gnu -coverage
rule_4 = FoBiS.py build -mode test-fdv-gradient-trigonometric-gnu   -coverage
rule_5 = FoBiS.py build -mode test-fdv-laplacian-trigonometric-gnu  -coverage
rule_6 = FoBiS.py build -mode test-fdv-operators-step-gnu           -coverage
rule_7 = FoBiS.py build -mode test-fdv-operators-trigonometric-gnu  -coverage

[rule-makecoverage]
help   = Rule for performing coverage analysis
rule_1 = FoBiS.py rule -ex build-tests-fdv
rule_2 = ./scripts/run_tests.sh --np 1
rule_3 = rm -f exe/obj/befor64* exe/obj/face* exe/obj/finer* exe/obj/fundal* exe/obj/fossil* exe/obj/foxy* exe/obj/mortif* exe/obj/motion* exe/obj/penf* exe/obj/stringifor* exe/obj/vtkfortran* exe/obj/vecfor*
rule_4 = ./scripts/compute-coverage.sh

[rule-makecoverage-analysis]
help   = Rule for performing coverage analysis and saving reports in markdown
rule_1 = FoBiS.py rule -ex build-tests-fdv
rule_2 = ./scripts/run_tests.sh --np 1
rule_3 = rm -f exe/obj/befor64* exe/obj/face* exe/obj/finer* exe/obj/fundal* exe/obj/fossil* exe/obj/foxy* exe/obj/mortif* exe/obj/motion* exe/obj/penf* exe/obj/stringifor* exe/obj/vtkfortran* exe/obj/vecfor*
rule_4 = ./scripts/compute-coverage.sh
rule_5 = FoBiS.py rule -gcov_analyzer docs/guide/
rule_6 = rm -f *.gcov

