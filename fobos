[ascot-nvf-mpi-cuda]
help         = Build ascot app with NVF-CUDA on SZ laptop
template     = template-base
target       = ascot.F90
preproc      = -D_NVF
compiler     = nvfortran
cflags       = -cpp -c -Mcuda=cc75,cuda12.0,ptxinfo -O2
lflags       = -Mcuda=cc75,cuda12.0,ptxinfo -O2

# templates
[template-base]
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
build_dir    = ./exe/
colors       = True
quiet        = False
log          = True
jobs         = 4
mpi          = True
ext_libs     = dl m
exclude_dirs = src/lib_experimental/
               references/
               BeFoR64/src/tests/
               BeFoR64/src/third_party/
               FACE/src/tests/
               FACE/src/third_party/
               FiNeR/src/tests/
               FiNeR/src/third_party/
               FOSSIL/src/app/
               FOSSIL/src/tests/
               FOSSIL/src/third_party/
               FoXy/src/tests/
               FoXy/src/third_party/
               MORTIF/src/tests/
               MORTIF/src/third_party/
               PENF/src/tests/
               StringiFor/src/tests/
               StringiFor/src/third_party/
               VecFor/src/tests/
               VecFor/src/third_party/
               VTKFortran/src/tests/
               VTKFortran/src/third_party/
               third_party_manual/

# aux rules
[rule-makethirdpartymanual]
help   = Make third party manual-compiling libraries on SZ laptop
rule_1 = mkdir -p exe/mod exe/obj
rule_2 = cd src/third_party_manual/CGAL/ ; g++ -std=c++17 -frounding-math -O2 -I/opt/cgal/5.2.1/include/ -c cgal_c_wrappers.cpp ; cd -
rule_3 = cd src/third_party_manual/getmemory/ ; gcc -c getmemory.c ; cd -
rule_4 = mv src/third_party_manual/getmemory/*.o exe/obj/
rule_5 = mv src/third_party_manual/CGAL/*.o exe/obj/

[rule-makethirdpartymanual-leo]
help   = Make third party manual-compiling libraries on marconi100 cluster
rule_1 = mkdir -p exe/mod exe/obj
rule_2 = cd src/third_party_manual/CGAL/ ; g++ -std=c++17 -frounding-math -O2 -I/leonardo/prod/spack/03/install/0.19/linux-rhel8-icelake/nvhpc-23.1/boost-1.80.0-iq4pew7yycxkz2wcx6ckm2ix25cuozqv/include -I/leonardo/home/userinternal/fsalvado/ADAM/CGAL/CGAL-5.0.2/include/ -c cgal_c_wrappers.cpp ; cd -
rule_3 = cd src/third_party_manual/getmemory/ ; gcc -c getmemory.c ; cd -
rule_4 = mv src/third_party_manual/getmemory/*.o exe/obj/
rule_5 = mv src/third_party_manual/CGAL/*.o exe/obj/

[rule-makedoc]
help   = Build documentation from source files
rule_1 = rm -rf doc/html/*
rule_2 = ford doc/main_page.md --debug
rule_3 = cp -r doc/html/publish/* doc/html/
rule_4 = rm -rf doc/html/publish

[rule-deldoc]
help = Delete documentation
rule = rm -rf doc/html/*
