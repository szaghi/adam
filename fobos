[adam-com-lib-gnu]
help     = Build ADAM common library with GNU on SZ laptop
template = template-base
target   = adam_common_library.F90
output   = libadamcommon.a
mklib    = static
preproc  = -D_MPI_
compiler = gnu
cflags   = -cpp -c -O2
lflags   = -O2
lib_dir  = $HDF5_gnu/lib
include  = $HDF5_gnu/include
libs     = $HDF5_gnu/lib/libhdf5hl_fortran.a
           $HDF5_gnu/lib/libhdf5_hl.a
