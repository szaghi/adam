# main modes
[nasto-nvf-mpi-cuda]
help     = Build NASTO NVF app with NVF-MPI-CUDA on SZ laptop
template = template-base
target   = adam_nasto_nvf.F90
preproc  = -D_NVF -D_MPI_
compiler = nvfortran
cflags   = -cpp -c -Mcuda=cc75,cuda12.0,ptxinfo -O2
lflags   = -Mcuda=cc75,cuda12.0,ptxinfo -O2
lib_dir  = $HDF5_cuda_22_3/lib
include  = $HDF5_cuda_22_3/include
libs     = $HDF5_cuda_22_3/lib/libhdf5hl_fortran.a
           $HDF5_cuda_22_3/lib/libhdf5_hl.a
           $HDF5_cuda_22_3/lib/libhdf5_fortran.a
           $HDF5_cuda_22_3/lib/libhdf5.a
           -Wl,-rpath,/usr/lib/gcc/x86_64-linux-gnu/11 /usr/lib/gcc/x86_64-linux-gnu/11/libstdc++.so
           $ZLIB_sz
           $SZIP_sz
           $GETMEMORY
           $CGAL

