 , crown ) kdelta = l_map_bc_gpu ( c , 7 , crown ) bc_type = l_map_bc_gpu ( c , 8 , crown ) fec = l_map_bc_gpu ( c , 9 , crown ) fec_1_6 = fec_1_6_array_gpu ( fec ) if ( bc_type == BC_EXTRAPOLATION ) then do v = 1 , nv q_gpu ( b , i , j , k , v ) = q_gpu ( b , i - idelta , j - jdelta , k - kdelta , v ) enddo else if ( bc_type == BC_INFLOW ) then q_gpu ( b , i , j , k , 1 ) = q_bc_vars_gpu ( 1 , fec_1_6 ) q_gpu ( b , i , j , k , 2 ) = q_bc_vars_gpu ( 1 , fec_1_6 ) * q_bc_vars_gpu ( 2 , fec_1_6 ) q_gpu ( b , i , j , k , 3 ) = q_bc_vars_gpu ( 1 , fec_1_6 ) * q_bc_vars_gpu ( 3 , fec_1_6 ) q_gpu ( b , i , j , k , 4 ) = q_bc_vars_gpu ( 1 , fec_1_6 ) * q_bc_vars_gpu ( 4 , fec_1_6 ) q_gpu ( b , i , j , k , 5 ) = q_bc_vars_gpu ( 1 , fec_1_6 ) * & ( cv * q_bc_vars_gpu ( 5 , fec_1_6 ) / ( q_bc_vars_gpu ( 1 , fec_1_6 ) * R ) + & 0.5_R8P * ( q_bc_vars_gpu ( 2 , fec_1_6 ) ** 2 + q_bc_vars_gpu ( 3 , fec_1_6 ) ** 2 + q_bc_vars_gpu ( 4 , fec_1_6 ) ** 2 )) endif endif enddo enddo endsubroutine set_bc_q_gpu_dev","tags":"","url":"proc/set_bc_q_gpu_dev.html"},{"title":"compute_fluxes_convective_ri_dev – ADAM","text":"private  subroutine compute_fluxes_convective_ri_dev(dir, si, sir, b, i, j, k, ngc, nv, weno_s, weno_a_gpu, weno_p_gpu, weno_d_gpu, weno_zeps, ror_number, ror_schemes_gpu, ror_threshold, ror_ivar_gpu, ror_stats_gpu, g, q_aux_gpu, fluxes_gpu) Compute convective fluxes at right interface of b,i,j,k. Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: dir Direction, 1=X, 2=Y, 3=Z. integer(kind=I4P), intent(in) :: si (3) Stencil increment. real(kind=R8P), intent(in) :: sir (3) Stencil increment, real cast. integer(kind=I4P), intent(in) :: b Counter. integer(kind=I4P), intent(in) :: i Counter. integer(kind=I4P), intent(in) :: j Counter. integer(kind=I4P), intent(in) :: k Counter. integer(kind=I4P), intent(in) :: ngc Ghost cells number. integer(kind=I4P), intent(in) :: nv Number of conservative varibales. integer(kind=I4P), intent(in) :: weno_s Weno stencils number/dimension. real(kind=R8P), intent(in) :: weno_a_gpu (1:,0:,1:) Optimal weights. real(kind=R8P), intent(in) :: weno_p_gpu (1:,0:,0:,1:) Polinomials coefficients. real(kind=R8P), intent(in) :: weno_d_gpu (0:,0:,0:,1:) Smoothness indicators coefficients. real(kind=R8P), intent(in) :: weno_zeps Parameter to avoid division by zero. integer(kind=I4P), intent(in) :: ror_number Number of ROR iterations. integer(kind=I4P), intent(in) :: ror_schemes_gpu (1:) Scheme (S value) for each ROR step. real(kind=R8P), intent(in) :: ror_threshold ROR threshold triggering. integer(kind=I4P), intent(in) :: ror_ivar_gpu (1:) Index variables to check in ROR. integer(kind=I4P), intent(inout) :: ror_stats_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Scheme (S value) for each ROR step. real(kind=R8P), intent(in) :: g Specific heats ratio. real(kind=R8P), intent(in) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(inout) :: fluxes_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Fluxes. Calls proc~~compute_fluxes_convective_ri_dev~~CallsGraph proc~compute_fluxes_convective_ri_dev compute_fluxes_convective_ri_dev proc~compute_eigenvectors_dev compute_eigenvectors_dev proc~compute_fluxes_convective_ri_dev->proc~compute_eigenvectors_dev proc~decompose_fluxes_convective_device~3 decompose_fluxes_convective_device proc~compute_fluxes_convective_ri_dev->proc~decompose_fluxes_convective_device~3 weno_reconstruct_upwind_dev weno_reconstruct_upwind_dev proc~compute_fluxes_convective_ri_dev->weno_reconstruct_upwind_dev proc~compute_roe_average_device~3 compute_roe_average_device proc~compute_eigenvectors_dev->proc~compute_roe_average_device~3 proc~compute_conservative_fluxes_dev compute_conservative_fluxes_dev proc~decompose_fluxes_convective_device~3->proc~compute_conservative_fluxes_dev proc~compute_conservatives_dev compute_conservatives_dev proc~decompose_fluxes_convective_device~3->proc~compute_conservatives_dev proc~compute_max_eigenvalues_dev compute_max_eigenvalues_dev pro