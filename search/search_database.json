 optional :: mu !< Dynamic viscosity. real ( R8P ), intent ( in ), optional :: kd !< Thermal diffusivity. real ( R8P ), intent ( in ), optional :: dha !< Entalpy formation. real ( R8P ), intent ( in ), optional :: cp !< Specific heat at constant pressure `cp` value. real ( R8P ), intent ( in ), optional :: cv !< Specific heat at constant volume `cv` value. real ( R8P ), intent ( in ), optional :: gam !< Specific heats ratio `gamma=cp/cv` value. real ( R8P ), intent ( in ), optional :: R !< Fluid constant `R=cp-cv` value. call self % mpih % initialize if ( present ( physics )) then self = physics else self = nasto_eos_object ( mu = mu , kd = kd , dha = dha , cp = cp , cv = cv , gam = gam , R = R ) endif endsubroutine initialize","tags":"","url":"proc/initialize.html"},{"title":"load_from_file – ADAM","text":"private  subroutine load_from_file(self, file_parameters, s, go_on_fail) Load from file. Type Bound nasto_eos_object Arguments Type Intent Optional Attributes Name class( nasto_eos_object ), intent(inout) :: self Fluid physics. type(file_ini), intent(in) :: file_parameters Simulation parameters ini file handler. integer(kind=I4P), intent(in) :: s Fluid specie number. logical, intent(in), optional :: go_on_fail Go on if load fails. Calls proc~~load_from_file~~CallsGraph proc~load_from_file nasto_eos_object%load_from_file error_stop error_stop proc~load_from_file->error_stop get get proc~load_from_file->get proc~compute_derivate nasto_eos_object%compute_derivate proc~load_from_file->proc~compute_derivate proc~destroy nasto_eos_object%destroy proc~load_from_file->proc~destroy str str proc~load_from_file->str Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from