tional (1=x,2=y,3=z) increment. real ( R8P ), intent ( in ) :: q_aux ( 1 :) !< Auxiliary variables. real ( R8P ), intent ( inout ) :: f ( 1 :) !< Conservative fluxes. f ( 1 ) = q_aux ( 1 ) * q_aux ( 2 ) * sir ( 1 ) + & q_aux ( 1 ) * q_aux ( 3 ) * sir ( 2 ) + & q_aux ( 1 ) * q_aux ( 4 ) * sir ( 3 ) f ( 2 ) = f ( 1 ) * q_aux ( 2 ) + q_aux ( 7 ) * sir ( 1 ) f ( 3 ) = f ( 1 ) * q_aux ( 3 ) + q_aux ( 7 ) * sir ( 2 ) f ( 4 ) = f ( 1 ) * q_aux ( 4 ) + q_aux ( 7 ) * sir ( 3 ) f ( 5 ) = f ( 1 ) * q_aux ( 8 ) endsubroutine compute_conservative_fluxes_scalar","tags":"","url":"proc/compute_conservative_fluxes_scalar.html"},{"title":"compute_interstates_23_ts – ADAM","text":"private elemental subroutine compute_interstates_23_ts(p1, r1, u1, a1, g1, p4, r4, u4, a4, g4, u23, p23, r2, r3, S1, S2, S3, S4) Arguments Type Intent Optional Attributes Name real(kind=R8P), intent(in) :: p1 real(kind=R8P), intent(in) :: r1 real(kind=R8P), intent(in) :: u1 real(kind=R8P), intent(in) :: a1 real(kind=R8P), intent(in) :: g1 real(kind=R8P), intent(in) :: p4 real(kind=R8P), intent(in) :: r4 real(kind=R8P), intent(in) :: u4 real(kind=R8P), intent(in) :: a4 real(kind=R8P), intent(in) :: g4 real(kind=R8P), intent(out) :: u23 real(kind=R8P), intent(out) :: p23 real(kind=R8P), intent(out) :: r2 real(kind=R8P), intent(out) :: r3 real(kind=R8P), intent(out) :: S1 real(kind=R8P), intent(out) :: S2 real(kind=R8P), intent(out) :: S3 real(kind=R8P), intent(out) :: S4 Called by proc~~compute_interstates_23_ts~~CalledByGraph proc~compute_interstates_23_ts compute_interstates_23_ts proc~compute_riemann_ts compute_riemann_ts proc~compute_riemann_ts->proc~compute_interstates_23_ts Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code elemental subroutine compute_interstates_23_ts ( p1 , r1 , u1 , a1 , g1 , p4 , r4 , u4 , a4 , g4 , u23 , p23 , r2 , r3 , S1 , S2 , S3 , S4 ) ! Subroutine for evaluating intermediate states using TS (Two Shocks) approximation. real ( R8P ), intent ( in ) :: p1 ! Pressure of state 1. real ( R8P ), intent ( in ) :: r1 ! Density of state 1. real ( R8P ), intent ( in ) :: u1 ! Velocity of state 1. real ( R8P ), intent ( in ) :: a1 ! Speed of sound of state 1. real ( R8P ), intent ( in ) :: g1 ! Specific heats ratio of state 1. real ( R8P ), intent ( in ) :: p4 ! Pressure of state 4. real ( R8P ), intent ( in ) :: r4 ! Density of state 4. real ( R8P ), intent ( in ) :: u4 ! Velocity of state 4. real ( R8P ), intent ( in ) :: a4 ! Speed of sound of state 1. real ( R8P ), intent ( in ) :: g4 ! Specific heats ratio of state 4. real ( R8P ), intent ( out ) :: u23 ! Velocity of intermediate states. real ( R8P ), intent ( out ) :: p23 ! Pressure of intermediate states. real ( R8P ), intent ( out ) :: r2 ! Density of state 2. real ( R8P ), intent ( out ) :: r3 ! Density of state 3. real ( R8P ), intent ( out ) :: S1 , S2 ! Left signal velocities. real ( R8P ), intent ( out ) :: S3 , S4 ! Right signal velocities. real ( R8P ) :: gp1 , gm1 ! g+1, g-1. real ( R8P ) :: p_p ! Pressure ratio. real ( R8P ) :: g1p , g4p ! Dummy variables for computing TS pressure of intermediate states. real ( R8P ) :: gm1_gp1 ! g+1, (g-1)/(g+1). ! evaluating intermediate states pressure and velocity p23 = 0.5_R8P * (( p1 + p4 ) - 0.25_R8P * ( u4 - u1 ) * ( r1 + r4 ) * ( a1 + a4 )) gp1 = g1 + 1._R8P ; gm1_gp1 = ( g1 - 1._R8P ) / gp1 ; g1p = sqrt (( 2._R8P / ( gp1 * r1 )) / ( p23 + gm1_gp1 * p1 )) gp1 = g4 + 1._R8P ; gm1_gp1 = ( g4 - 1._R8P ) / gp1 ; g4p = sqrt (( 2._R8P / ( gp1 * r4 )) / ( p23 + gm1_gp1 * p4 )) p23 = ( g1p * p1 + g4p * p4 + u1 - u4 ) / ( g1p + g4p ) u23 = 0.5_R8P * ( u1 + u4 + ( p23 - p4 ) * g4p - ( p23 - p1 ) * g1p ) ! evaluating left state p_p = p23 / p1 gp1 = g1 + 1._R8P gm1 = g1 - 1._R8P r2 = r1 * (( gm1 + gp1 * p_p ) / ( gp1 + gm1 * p_p )) S1 = u1 - a1 * sqrt ( 1._R8P + 0.5_R8P * gp1 / g1 * ( p_p - 1._R8P )) S2 = S1 ! evaluating right state p_p = p23 / p4 gp1 = g4 + 1._R8P gm1 = g4 - 1._R8P r3 = r4 * (( gm1 + gp1 * p_p ) / ( gp1 + gm1 * p_p )) S4 = u4 + a4 * sqrt ( 1._R8P + 0.5_R8P * gp1 / g4 * ( p_p - 1._R8P )) S3 = S4 endsubroutine compute_interstates_23_ts","tags":"","url":"proc/compute_interstates_23_ts.html"},{"title":"compute_interstates_23u – ADAM","text":"private elemental subroutine compute_interstates_23u(p1, u1, a1, g1, gm1_1, gp1_1, delta1, eta1, p4, u4, a4, g4, gm1_4, gp1_4, delta4, eta4, u23, r2, p2, a2, r3, p3, a3, S1, S2, S3, S4) Compute intermediates states knowing the value of speed (u23) of intermediates states. Arguments Type Intent Optional Attributes Name real(kind=R8P), intent(in) :: p1 Pressure of state 1. real(kind=R8P), intent(in) :: u1 Velocity of state 1. real(kind=R8P), intent(in) :: a1 Speed of sound of state 1. real(kind=R8P), intent(in) :: g1 Specific heats ratio of state 1. real(kind=R8P), intent(in) :: gm1_1 g-1, g+1 of state 1. real(kind=R8P), intent(in) :: gp1_1 g-1, g+1 of state 1. real(kind=R8P), intent(in) :: delta1 (g-1)/2, 2*g/(g-1) of state 1. real(kind=R8P), intent(in) :: eta1 (g-1)/2, 2*g/(g-1) of state 1. real(kind=R8P), intent(in) :: p4 Pressure of state 4. real(kind=R8P), intent(in) :: u4 Velocity of state 4. real(kind=R8P), intent(in) :: a4 Speed of sound of state 4. real(kind=R8P), intent(in) :: g4 Specific heats ratio of state 4. real(kind=R8P), intent(in) :: gm1_4 g-1, g+1 of state 4. real(kind=R8P), intent(in) :: gp1_4 g-1, g+1 of state 4. real(kind=R8P), intent(in) :: delta4 (g-1)/2, 2*g/(g-1) of state 4. real(kind=R8P), intent(in) :: eta4 (g-1)/2, 2*g/(g-1) of state 4. real(kind=R8P), intent(in) :: u23 Velocity of intermediate states. real(kind=R8P), intent(out) :: r2 Density, pressure and speed of sound of state 2. real(kind=R8P), intent(out) :: p2 Density, pressure and speed of sound of state 2. real(kind=R8P), intent(out) :: a2 Density, pressure and speed of sound of state 2. real(kind=R8P), intent(out) :: r3 Density, pressure and speed of sound of state 3. real(kind=R8P), intent(out) :: p3 Density, pressure and speed of sound of state 3. real(kind=R8P), intent(out) :: a3 Density, pressure and speed of sound of state 3. real(kind=R8P), intent(out) :: S1 Left signal velocities. real(kind=R8P), intent(out) :: S2 Left signal velocities. real(kind=R8P), intent(out) :: S3 Right signal velocities. real(kind=R8P), intent(out) :: S4 Right signal velocities. Calls proc~~compute_interstates_23u~~CallsGraph proc~compute_interstates_23u compute_interstates_23u proc~compute_rarefaction compute_rarefaction proc~compute_interstates_23u->proc~compute_rarefaction proc~compute_shock compute_shock proc~compute_interstates_23u->proc~compute_shock Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~compute_interstates_23u~~CalledByGraph proc~compute_interstates_23u compute_interstates_23u proc~compute_riemann_exact compute_riemann_exact proc~compute_riemann_exact->proc~compute_interstates_23u proc~compute_riemann_exact_2 compute_riemann_exact_2 proc~compute_riemann_exact_2->proc~compute_interstates_23u Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code elemental subroutine compute_interstates_23u ( p1 , u1 , a1 , g1 , gm1_1 , gp1_1 , delta1 , eta1 , & p4 , u4 , a4 , g4 , gm1_4 , gp1_4 , delta4 , eta4 , & u23 , & r2 , p2 , a2 , r3 , p3 , a3 , S1 , S2 , S3 , S4 ) !< Compute intermediates states knowing the value of speed (u23) of intermediates states. real ( R8P ), intent ( in ) :: p1 !< Pressure of state 1. real ( R8P ), intent ( in ) :: u1 !< Velocity of state 1. real ( R8P ), intent ( in ) :: a1 !< Speed of sound of state 1. real ( R8P ), intent ( in ) :: g1 !< Specific heats ratio of state 1. real ( R8P ), intent ( in ) :: gm1_1 , gp1_1 !< g-1, g+1 of state 1. real ( R8P ), intent ( in ) :: delta1 , eta1 !< (g-1)/2, 2*g/(g-1) of state 1. real ( R8P ), intent ( in ) :: p4 !< Pressure of state 4. real ( R8P ), intent ( in ) :: u4 !< Velocity of state 4. real ( R8P ), intent ( in ) :: a4 !< Speed of sound of state 4. real ( R8P ), intent ( in ) :: g4 !< Specific heats ratio of state 4. real ( R8P ), intent ( in ) :: gm1_4 , gp1_4 !< g-1, g+1 of state 4. real ( R8P ), intent ( in ) :: delta4 , eta4 !< (g-1)/2, 2*g/(g-1) of state 4. real ( R8P ), intent ( in ) :: u23 !< Velocity of intermediate states. real ( R8P ), intent ( out ) :: r2 , p2 , a2 !< Density, pressure and speed of sound of state 2. real ( R8P ), intent ( out ) :: r3 , p3 , a3 !< Density, pressure and speed of sound of state 3. real ( R8P ), intent ( out ) :: S1 , S2 !< Left signal velocities. real ( R8P ), intent ( out ) :: S3 , S4 !< Right signal velocities. ! computing left wave if ( abs ( u23 - u1 ) <= 1.e-16_R8P ) then call compute_rarefaction ( sgn = - 1._R8P , & g = g1 , & delta = delta1 , & eta = eta1 , & u0 = u1 , & p0 = p1 , & a0 = a1 , & ux = u23 , & rx = r2 , & px = p2 , & ax = a2 , & s0 = S1 , & sx = S2 ) else if ( u23 < u1 ) then call compute_shock ( sgn = - 1._R8P , & g = g1 , & gm1 = gm1_1 , & gp1 = gp1_1 , & u0 = u1 , & p0 = p1 , & a0 = a1 , & ux = u23 , & rx = r2 , & px = p2 , & ax = a2 , & ss = S1 ) S2 = S1 else call compute_rarefaction ( sgn = - 1._R8P , & g = g1 , & delta = delta1 , & eta = eta1 , & u0 = u1 , & p0 = p1 , & a0 = a1 , & ux = u23 , & rx = r2 , & px = p2 , & ax = a2 , & s0 = S1 , & sx = S2 ) endif endif ! computing right wave if ( abs ( u23 - u4 ) <= 1.e-16_R8P ) then call compute_rarefaction ( sgn = 1._R8P , & g = g4 , & delta = delta4 , & eta = eta4 , & u0 = u4 , & p0 = p4 , & a0 = a4 , & ux = u23 , & rx = r3 , & px = p3 , & ax = a3 , & s0 = S4 , & sx = S3 ) else if ( u23 > u4 ) then call compute_shock ( sgn = 1._R8P , & g = g4 , & gm1 = gm1_4 , & gp1 = gp1_4 , & u0 = u4 , & p0 = p4 , & a0 = a4 , & ux = u23 , & rx = r3 , & px = p3 , & ax = a3 , & ss = S4 ) S3 = S4 else call compute_rarefaction ( sgn = 1._R8P , & g = g4 , & delta = delta4 , & eta = eta4 , & u0 = u4 , & p0 = p4 , & a0 = a4 , & ux = u23 , & rx = r3 , & px = p3 , & ax = a3 , & s0 = S4 , & sx = S3 ) endif endif endsubroutine compute_interstates_23u","tags":"","url":"proc/compute_interstates_23u.html"},{"title":"compute_roe_average – ADAM","text":"private pure subroutine compute_roe_average(ngc, b, i, j, k, ip, jp, kp, g, q_aux, uu, vv, ww, h, qq, c, ci, b1, b2) Compute Roe averaged quantities. Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: ngc Number of ghost cells. integer(kind=I4P), intent(in) :: b Left/right cells indexes. integer(kind=I4P), intent(in) :: i Left/right cells indexes. integer(kind=I4P), intent(in) :: j Left/right cells indexes. integer(kind=I4P), intent(in) :: k Left/right cells indexes. integer(kind=I4P), intent(in) :: ip Left/right cells indexes. integer(kind=I4P), intent(in) :: jp Left/right cells indexes. integer(kind=I4P), intent(in) :: kp Left/right cells indexes. real(kind=R8P), intent(in) :: g Specific heats ratio. real(kind=R8P), intent(in) :: q_aux (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(out) :: uu Roe state average variables. real(kind=R8P), intent(out) :: vv Roe state average variables. real(kind=R8P), intent(out) :: ww Roe state average variables. real(kind=R8P), intent(out) :: h Roe state average variables. real(kind=R8P), intent(out) :: qq Roe state average variables. real(kind=R8P), intent(out) :: c Roe state average variables. real(kind=R8P), intent(out) :: ci Roe state average variables. real(kind=R8P), intent(out) :: b1 Roe state average variables. real(kind=R8P), intent(out) :: b2 Roe state average variables. Called by proc~~compute_roe_average~~CalledByGraph proc~compute_roe_average compute_roe_average proc~compute_eigenvectors compute_eigenvectors proc~compute_eigenvectors->proc~compute_roe_average Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure subroutine compute_roe_average ( ngc , b , i , j , k , ip , jp , kp , g , q_aux , & uu , vv , ww , h , qq , c , ci , b1 , b2 ) !< Compute Roe averaged quantities. integer ( I4P ), intent ( in ) :: ngc !< Number of ghost cells. integer ( I4P ), intent ( in ) :: b , i , j , k , ip , jp , kp !< Left/right cells indexes. real ( R8P ), intent ( in ) :: g !< Specific heats ratio. real ( R8P ), intent ( in ) :: q_aux ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( out ) :: uu , vv , ww , h , qq , c , ci , b1 , b2 !< Roe state average variables. real ( R8P ) :: ri , up , vp , wp , hp , r , rp1 , cc !< Local varbiables. ! left state (node i) ri = 1._R8P / q_aux ( 1 , i , j , k , b ) uu = q_aux ( 2 , i , j , k , b ) vv = q_aux ( 3 , i , j , k , b ) ww = q_aux ( 4 , i , j , k , b ) h = q_aux ( 8 , i , j , k , b ) ! right state (node i+1) up = q_aux ( 2 , ip , jp , kp , b ) vp = q_aux ( 3 , ip , jp , kp , b ) wp = q_aux ( 4 , ip , jp , kp , b ) hp = q_aux ( 8 , ip , jp , kp , b ) ! Roe average state r = sqrt ( q_aux ( 1 , ip , jp , kp , b ) * ri ) rp1 = 1._R8P / ( r + 1._R8P ) uu = ( r * up + uu ) * rp1 vv = ( r * vp + vv ) * rp1 ww = ( r * wp + ww ) * rp1 h = ( r * hp + h ) * rp1 qq = 0.5_R8P * ( uu * uu + vv * vv + ww * ww ) cc = ( g - 1._R8P ) * ( h - qq ) c = sqrt ( cc ) ci = 1._R8P / c b2 = ( g - 1 ) / cc ! alias 1/(cp*theta) b1 = b2 * qq ! alias q/(cp*theta) endsubroutine compute_roe_average","tags":"","url":"proc/compute_roe_average.html"},{"title":"compute_rarefaction – ADAM","text":"private elemental subroutine compute_rarefaction(sgn, g, delta, eta, u0, p0, a0, ux, rx, px, ax, s0, sx) Compute an unknown state “x” from a known state “0” when the two states are separated by a rarefaction; it is\nassumed that the velocity of the unknown state “ux” is known. There is an input variable that indicates if the rarefaction\npropagates on the “u-a” direction (left) or on the “u+a” one (right). Arguments Type Intent Optional Attributes Name real(kind=R8P), intent(in) :: sgn Sign for distinguishing “left” (-1) from “right” (1) wave. real(kind=R8P), intent(in) :: g Specific heats ratio. real(kind=R8P), intent(in) :: delta (g-1)/2. real(kind=R8P), intent(in) :: eta 2*g/(g-1). real(kind=R8P), intent(in) :: u0 Known state (speed, pressure and speed of sound). real(kind=R8P), intent(in) :: p0 Known state (speed, pressure and speed of sound). real(kind=R8P), intent(in) :: a0 Known state (speed, pressure and speed of sound). real(kind=R8P), intent(in) :: ux Known speed of unknown state. real(kind=R8P), intent(out) :: rx Unknown pressure and density. real(kind=R8P), intent(out) :: px Unknown pressure and density. real(kind=R8P), intent(out) :: ax Unknown pressure and density. real(kind=R8P), intent(out) :: s0 Wave speeds (head and back fronts). real(kind=R8P), intent(out) :: sx Wave speeds (head and back fronts). Called by proc~~compute_rarefaction~~CalledByGraph proc~compute_rarefaction compute_rarefaction proc~compute_interstates_23u compute_interstates_23u proc~compute_interstates_23u->proc~compute_rarefaction proc~compute_riemann_exact compute_riemann_exact proc~compute_riemann_exact->proc~compute_interstates_23u proc~compute_riemann_exact_2 compute_riemann_exact_2 proc~compute_riemann_exact_2->proc~compute_interstates_23u Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code elemental subroutine compute_rarefaction ( sgn , g , delta , eta , u0 , p0 , a0 , ux , rx , px , ax , s0 , sx ) !< Compute an unknown state \"x\" from a known state \"0\" when the two states are separated by a rarefaction; it is !< assumed that the velocity of the unknown state \"ux\" is known. There is an input variable that indicates if the rarefaction !< propagates on the \"u-a\" direction (left) or on the \"u+a\" one (right). real ( R8P ), intent ( in ) :: sgn !< Sign for distinguishing \"left\" (-1) from \"right\" (1) wave. real ( R8P ), intent ( in ) :: g !< Specific heats ratio. real ( R8P ), intent ( in ) :: delta !< (g-1)/2. real ( R8P ), intent ( in ) :: eta !< 2*g/(g-1). real ( R8P ), intent ( in ) :: u0 , p0 , a0 !< Known state (speed, pressure and speed of sound). real ( R8P ), intent ( in ) :: ux !< Known speed of unknown state. real ( R8P ), intent ( out ) :: rx , px , ax !< Unknown pressure and density. real ( R8P ), intent ( out ) :: s0 , sx !< Wave speeds (head and back fronts). ax = a0 + sgn * delta * ( ux - u0 ) ! unknown speed of sound px = p0 * (( ax / a0 ) ** ( eta )) ! unknown pressure rx = g * px / ( ax * ax ) ! unknown density s0 = u0 + sgn * a0 ! left wave speed sx = ux + sgn * ax ! right wave speed endsubroutine compute_rarefaction","tags":"","url":"proc/compute_rarefaction.html"},{"title":"compute_shock – ADAM","text":"private elemental subroutine compute_shock(sgn, g, gm1, gp1, u0, p0, a0, ux, rx, px, ax, ss) Compute an unknown state “x” from a known state “0” when the two states are separated by a shock; it is\nassumed that the velocity of the unknown state “ux” is known. There is an input variable that indicates if the shock\npropagates on the “u-a” direction (left) or on the “u+a” one (right). Arguments Type Intent Optional Attributes Name real(kind=R8P), intent(in) :: sgn Sign for distinguishing “left” (-1) from “right” (1) wave. real(kind=R8P), intent(in) :: g Specific heats ratio. real(kind=R8P), intent(in) :: gm1 Gm1 = g - 1 , gp1 = g + 1. real(kind=R8P), intent(in) :: gp1 Gm1 = g - 1 , gp1 = g + 1. real(kind=R8P), intent(in) :: u0 Known state (speed, pressure and speed of sound). real(kind=R8P), intent(in) :: p0 Known state (speed, pressure and speed of sound). real(kind=R8P), intent(in) :: a0 Known state (speed, pressure and speed of sound). real(kind=R8P), intent(in) :: ux Unknown speed. real(kind=R8P), intent(out) :: rx Unknown state (density, pressure and speed of sound). real(kind=R8P), intent(out) :: px Unknown state (density, pressure and speed of sound). real(kind=R8P), intent(out) :: ax Unknown state (density, pressure and speed of sound). real(kind=R8P), intent(out) :: ss Shock wave speed. Called by proc~~compute_shock~~CalledByGraph proc~compute_shock compute_shock proc~compute_interstates_23u compute_interstates_23u proc~compute_interstates_23u->proc~compute_shock proc~compute_riemann_exact compute_riemann_exact proc~compute_riemann_exact->proc~compute_interstates_23u proc~compute_riemann_exact_2 compute_riemann_exact_2 proc~compute_riemann_exact_2->proc~compute_interstates_23u Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code elemental subroutine compute_shock ( sgn , g , gm1 , gp1 , u0 , p0 , a0 , ux , rx , px , ax , ss ) !< Compute an unknown state \"x\" from a known state \"0\" when the two states are separated by a shock; it is !< assumed that the velocity of the unknown state \"ux\" is known. There is an input variable that indicates if the shock !< propagates on the \"u-a\" direction (left) or on the \"u+a\" one (right). real ( R8P ), intent ( in ) :: sgn !< Sign for distinguishing \"left\" (-1) from \"right\" (1) wave. real ( R8P ), intent ( in ) :: g !< Specific heats ratio. real ( R8P ), intent ( in ) :: gm1 , gp1 !< Gm1 = g - 1 , gp1 = g + 1. real ( R8P ), intent ( in ) :: u0 , p0 , a0 !< Known state (speed, pressure and speed of sound). real ( R8P ), intent ( in ) :: ux !< Unknown speed. real ( R8P ), intent ( out ) :: rx , px , ax !< Unknown state (density, pressure and speed of sound). real ( R8P ), intent ( out ) :: ss !< Shock wave speed. real ( R8P ) :: M0 !< Relative Mach number of known state. real ( R8P ) :: x !< Dummy variable. x = 0.25_R8P * gp1 * ( ux - u0 ) / a0 ! dummy variable M0 = x + sgn * sqrt ( 1.0_R8P + x * x ) ! relative Mach number of known state x = 1._R8P + 2._R8P * g * ( M0 * M0 - 1._R8P ) / gp1 ! dummy variable (pressure ratio px/p0) ax = a0 * sqrt (( gp1 + gm1 * x ) / ( gp1 + gm1 / x )) ! unknown speed of sound px = p0 * x ! unknown pressure rx = g * px / ( ax * ax ) ! unknown density ss = u0 + a0 * M0 ! shock wave speed endsubroutine compute_shock","tags":"","url":"proc/compute_shock.html"},{"title":"evaluate_waves_pvrs – ADAM","text":"private pure subroutine evaluate_waves_pvrs(uni, q_aux1, q_aux4, g1, g4, S1, S, S4, lmax, p) Evaluate intermediate waves 2 and 3 from the known states 1,4 using the PVRS approximation. Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: uni Index of normal velocity. real(kind=R8P), intent(in) :: q_aux1 (1:) Left state, auxiliary variables. real(kind=R8P), intent(in) :: q_aux4 (1:) Left state, auxiliary variables. real(kind=R8P), intent(in) :: g1 Specific heats ratio of state 1. real(kind=R8P), intent(in) :: g4 Specific heats ratio of state 4. real(kind=R8P), intent(out) :: S1 Waves speed estimations. real(kind=R8P), intent(out) :: S Waves speed estimations. real(kind=R8P), intent(out) :: S4 Waves speed estimations. real(kind=R8P), intent(out), optional :: lmax Maximum wave speed estimation. real(kind=R8P), intent(out), optional :: p Pressure of the intermediate states. Called by proc~~evaluate_waves_pvrs~~CalledByGraph proc~evaluate_waves_pvrs evaluate_waves_pvrs proc~compute_riemann_hllc compute_riemann_hllc proc~compute_riemann_hllc->proc~evaluate_waves_pvrs proc~compute_riemann_llf compute_riemann_llf proc~compute_riemann_llf->proc~evaluate_waves_pvrs Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code pure subroutine evaluate_waves_pvrs ( uni , q_aux1 , q_aux4 , g1 , g4 , S1 , S , S4 , lmax , p ) !< Evaluate intermediate waves 2 and 3 from the known states 1,4 using the PVRS approximation. integer ( I4P ), intent ( in ) :: uni !< Index of normal velocity. real ( R8P ), intent ( in ) :: q_aux1 ( 1 :) !< Left state, auxiliary variables. real ( R8P ), intent ( in ) :: q_aux4 ( 1 :) !< Left state, auxiliary variables. real ( R8P ), intent ( in ) :: g1 !< Specific heats ratio of state 1. real ( R8P ), intent ( in ) :: g4 !< Specific heats ratio of state 4. real ( R8P ), intent ( out ) :: S1 , S , S4 !< Waves speed estimations. real ( R8P ), intent ( out ), optional :: lmax !< Maximum wave speed estimation. real ( R8P ), intent ( out ), optional :: p !< Pressure of the intermediate states. real ( R8P ) :: p_ !< Pressure of the intermediate states, local variable. real ( R8P ) :: ram !< Mean value of rho*a. associate ( a1 => q_aux1 ( 9 ), a4 => q_aux4 ( 9 ), & r1 => q_aux1 ( 1 ), r4 => q_aux4 ( 1 ), & u1 => q_aux1 ( uni ), u4 => q_aux4 ( uni ), & p1 => q_aux1 ( 7 ), p4 => q_aux4 ( 7 )) ram = 0.5_R8P * ( r1 + r4 ) * 0.5_R8P * ( a1 + a4 ) ! product of mean density for mean speed of sound S = 0.5_R8P * ( u1 + u4 ) - 0.5_R8P * ( p4 - p1 ) / ram ! evaluation of the contact wave speed (velocity of intermediate states) p_ = 0.5_R8P * ( p1 + p4 ) - 0.5_R8P * ( u4 - u1 ) * ram ! evaluation of the pressure of the intermediate states if ( present ( p )) p = p_ ! evaluation of the left wave speeds if ( p_ <= p1 * ( 1._R8P + 1.e-12_R8P )) then ! rarefaction S1 = u1 - a1 else ! shock S1 = u1 - a1 * sqrt ( 1._R8P + ( g1 + 1._R8P ) / ( 2._R8P * g1 ) * ( p_ / p1 - 1._R8P )) endif ! evaluation of the right wave speeds if ( p_ <= p4 * ( 1._R8P + 1.e-12_R8P )) then ! rarefaction S4 = u4 + a4 else ! shock S4 = u4 + a4 * sqrt ( 1._R8P + ( g4 + 1._R8P ) / ( 2._R8P * g4 ) * ( p_ / p4 - 1._R8P )) endif if ( present ( lmax )) lmax = max ( abs ( S1 ), abs ( S ), abs ( S4 )) endassociate endsubroutine evaluate_waves_pvrs","tags":"","url":"proc/evaluate_waves_pvrs.html"},{"title":"compute_conservatives_device – ADAM","text":"public  subroutine compute_conservatives_device(b, i, j, k, ngc, q_aux_gpu, q) Compute convervative variables from auxiliary ones. Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: b Cell indexes. integer(kind=I4P), intent(in) :: i Cell indexes. integer(kind=I4P), intent(in) :: j Cell indexes. integer(kind=I4P), intent(in) :: k Cell indexes. integer(kind=I4P), intent(in) :: ngc Ghost cells number. real(kind=R8P), intent(in) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(inout) :: q (1:) Conservative varibales. Called by proc~~compute_conservatives_device~2~~CalledByGraph proc~compute_conservatives_device~2 compute_conservatives_device proc~decompose_fluxes_convective_device~2 decompose_fluxes_convective_device proc~decompose_fluxes_convective_device~2->proc~compute_conservatives_device~2 proc~compute_fluxes_convective_device~2 compute_fluxes_convective_device proc~compute_fluxes_convective_device~2->proc~decompose_fluxes_convective_device~2 proc~compute_fluxes_convective_gmp compute_fluxes_convective_gmp proc~compute_fluxes_convective_gmp->proc~compute_fluxes_convective_device~2 proc~compute_residuals~4 nasto_gmp_object%compute_residuals proc~compute_residuals~4->proc~compute_fluxes_convective_gmp proc~integrate~4 nasto_gmp_object%integrate proc~integrate~4->proc~compute_residuals~4 proc~simulate~4 nasto_gmp_object%simulate proc~simulate~4->proc~integrate~4 program~adam_nasto_gmp adam_nasto_gmp program~adam_nasto_gmp->proc~simulate~4 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_conservatives_device ( b , i , j , k , ngc , q_aux_gpu , q ) !< Compute convervative variables from auxiliary ones. integer ( I4P ), intent ( in ) :: b , i , j , k !< Cell indexes. integer ( I4P ), intent ( in ) :: ngc !< Ghost cells number. real ( R8P ), intent ( in ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( inout ) :: q ( 1 :) !< Conservative varibales. !$omp declare target(compute_conservatives_device) q ( 1 ) = q_aux_gpu ( b , i , j , k , 1 ) q ( 2 ) = q ( 1 ) * q_aux_gpu ( b , i , j , k , 2 ) q ( 3 ) = q ( 1 ) * q_aux_gpu ( b , i , j , k , 3 ) q ( 4 ) = q ( 1 ) * q_aux_gpu ( b , i , j , k , 4 ) q ( 5 ) = q ( 1 ) * q_aux_gpu ( b , i , j , k , 8 ) - q_aux_gpu ( b , i , j , k , 7 ) endsubroutine compute_conservatives_device","tags":"","url":"proc/compute_conservatives_device~2.html"},{"title":"compute_conservative_fluxes_device – ADAM","text":"public  subroutine compute_conservative_fluxes_device(sir, b, i, j, k, ngc, q_aux_gpu, f) Compute convervative fluxes from auxiliary variables. Arguments Type Intent Optional Attributes Name real(kind=R8P), intent(in) :: sir (3) Directional (1=x,2=y,3=z) increment. integer(kind=I4P), intent(in) :: b Cell indexes. integer(kind=I4P), intent(in) :: i Cell indexes. integer(kind=I4P), intent(in) :: j Cell indexes. integer(kind=I4P), intent(in) :: k Cell indexes. integer(kind=I4P), intent(in) :: ngc Ghost cells number. real(kind=R8P), intent(in) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(inout) :: f (1:) Conservative fluxes. Called by proc~~compute_conservative_fluxes_device~2~~CalledByGraph proc~compute_conservative_fluxes_device~2 compute_conservative_fluxes_device proc~decompose_fluxes_convective_device~2 decompose_fluxes_convective_device proc~decompose_fluxes_convective_device~2->proc~compute_conservative_fluxes_device~2 proc~compute_fluxes_convective_device~2 compute_fluxes_convective_device proc~compute_fluxes_convective_device~2->proc~decompose_fluxes_convective_device~2 proc~compute_fluxes_convective_gmp compute_fluxes_convective_gmp proc~compute_fluxes_convective_gmp->proc~compute_fluxes_convective_device~2 proc~compute_residuals~4 nasto_gmp_object%compute_residuals proc~compute_residuals~4->proc~compute_fluxes_convective_gmp proc~integrate~4 nasto_gmp_object%integrate proc~integrate~4->proc~compute_residuals~4 proc~simulate~4 nasto_gmp_object%simulate proc~simulate~4->proc~integrate~4 program~adam_nasto_gmp adam_nasto_gmp program~adam_nasto_gmp->proc~simulate~4 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_conservative_fluxes_device ( sir , b , i , j , k , ngc , q_aux_gpu , f ) !< Compute convervative fluxes from auxiliary variables. real ( R8P ), intent ( in ) :: sir ( 3 ) !< Directional (1=x,2=y,3=z) increment. integer ( I4P ), intent ( in ) :: b , i , j , k !< Cell indexes. integer ( I4P ), intent ( in ) :: ngc !< Ghost cells number. real ( R8P ), intent ( in ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( inout ) :: f ( 1 :) !< Conservative fluxes. !$omp declare target(compute_conservative_fluxes_device) f ( 1 ) = q_aux_gpu ( b , i , j , k , 1 ) * q_aux_gpu ( b , i , j , k , 2 ) * sir ( 1 ) + & q_aux_gpu ( b , i , j , k , 1 ) * q_aux_gpu ( b , i , j , k , 3 ) * sir ( 2 ) + & q_aux_gpu ( b , i , j , k , 1 ) * q_aux_gpu ( b , i , j , k , 4 ) * sir ( 3 ) f ( 2 ) = f ( 1 ) * q_aux_gpu ( b , i , j , k , 2 ) + q_aux_gpu ( b , i , j , k , 7 ) * sir ( 1 ) f ( 3 ) = f ( 1 ) * q_aux_gpu ( b , i , j , k , 3 ) + q_aux_gpu ( b , i , j , k , 7 ) * sir ( 2 ) f ( 4 ) = f ( 1 ) * q_aux_gpu ( b , i , j , k , 4 ) + q_aux_gpu ( b , i , j , k , 7 ) * sir ( 3 ) f ( 5 ) = f ( 1 ) * q_aux_gpu ( b , i , j , k , 8 ) endsubroutine compute_conservative_fluxes_device","tags":"","url":"proc/compute_conservative_fluxes_device~2.html"},{"title":"compute_max_eigenvalues_device – ADAM","text":"public  subroutine compute_max_eigenvalues_device(si, sir, weno_s, b, i, j, k, ngc, nv, q_aux_gpu, evmax) Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: si (3) Stencil increment. real(kind=R8P), intent(in) :: sir (3) Stencil increment, real cast. integer(kind=I4P), intent(in) :: weno_s Weno stencils number/dimension. integer(kind=I4P), intent(in) :: b Cell indexes. integer(kind=I4P), intent(in) :: i Cell indexes. integer(kind=I4P), intent(in) :: j Cell indexes. integer(kind=I4P), intent(in) :: k Cell indexes. integer(kind=I4P), intent(in) :: ngc Ghost cells number. integer(kind=I4P), intent(in) :: nv Number of conservative varibales. real(kind=R8P), intent(in) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(inout) :: evmax (1:) Maximum eigenvalues in the big stencil. Called by proc~~compute_max_eigenvalues_device~2~~CalledByGraph proc~compute_max_eigenvalues_device~2 compute_max_eigenvalues_device proc~decompose_fluxes_convective_device~2 decompose_fluxes_convective_device proc~decompose_fluxes_convective_device~2->proc~compute_max_eigenvalues_device~2 proc~compute_fluxes_convective_device~2 compute_fluxes_convective_device proc~compute_fluxes_convective_device~2->proc~decompose_fluxes_convective_device~2 proc~compute_fluxes_convective_gmp compute_fluxes_convective_gmp proc~compute_fluxes_convective_gmp->proc~compute_fluxes_convective_device~2 proc~compute_residuals~4 nasto_gmp_object%compute_residuals proc~compute_residuals~4->proc~compute_fluxes_convective_gmp proc~integrate~4 nasto_gmp_object%integrate proc~integrate~4->proc~compute_residuals~4 proc~simulate~4 nasto_gmp_object%simulate proc~simulate~4->proc~integrate~4 program~adam_nasto_gmp adam_nasto_gmp program~adam_nasto_gmp->proc~simulate~4 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_max_eigenvalues_device ( si , sir , weno_s , b , i , j , k , ngc , nv , q_aux_gpu , evmax ) ! Compute maximum eigenvalues in the big stencil. integer ( I4P ), intent ( in ) :: si ( 3 ) !< Stencil increment. real ( R8P ), intent ( in ) :: sir ( 3 ) !< Stencil increment, real cast. integer ( I4P ), intent ( in ) :: weno_s !< Weno stencils number/dimension. integer ( I4P ), intent ( in ) :: b , i , j , k !< Cell indexes. integer ( I4P ), intent ( in ) :: ngc !< Ghost cells number. integer ( I4P ), intent ( in ) :: nv !< Number of conservative varibales. real ( R8P ), intent ( in ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( inout ) :: evmax ( 1 :) !< Maximum eigenvalues in the big stencil. real ( R8P ) :: uu , c !< Speeds. real ( R8P ) :: ev ( nv ) !< Signals speeds. integer ( I4P ) :: s , is , js , ks , v !< Counter. !$omp declare target(compute_max_eigenvalues_device) evmax = - 1._R8P do s = 1 , 2 * weno_s is = i + ( s - weno_s ) * si ( 1 ) ; js = j + ( s - weno_s ) * si ( 2 ) ; ks = k + ( s - weno_s ) * si ( 3 ) uu = q_aux_gpu ( b , is , js , ks , 1 + 1 * si ( 1 ) + 2 * si ( 2 ) + 3 * si ( 3 )) c = q_aux_gpu ( b , is , js , ks , 9 ) ev ( 1 ) = abs ( uu - c ) ; ev ( 2 ) = abs ( uu ) ; ev ( 3 ) = abs ( uu + c ) ; ev ( 4 ) = ev ( 2 ) ; ev ( 5 ) = ev ( 2 ) do v = 1 , nv evmax ( v ) = max ( ev ( v ), evmax ( v )) enddo enddo endsubroutine compute_max_eigenvalues_device","tags":"","url":"proc/compute_max_eigenvalues_device~2.html"},{"title":"compute_eigenvectors_device – ADAM","text":"public  subroutine compute_eigenvectors_device(si, sir, b, i, j, k, ngc, nv, g, q_aux_gpu, el, er) Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: si (3) Stencil increment. real(kind=R8P), intent(in) :: sir (3) Stencil increment, real cast. integer(kind=I4P), intent(in) :: b Cell indexes. integer(kind=I4P), intent(in) :: i Cell indexes. integer(kind=I4P), intent(in) :: j Cell indexes. integer(kind=I4P), intent(in) :: k Cell indexes. integer(kind=I4P), intent(in) :: ngc Ghost cells number. integer(kind=I4P), intent(in) :: nv Number of conservative varibales. real(kind=R8P), intent(in) :: g Specific heats ratio. real(kind=R8P), intent(in) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(inout) :: el (1:nv,1:nv) Left and right eigenvectors. real(kind=R8P), intent(inout) :: er (1:nv,1:nv) Left and right eigenvectors. Calls proc~~compute_eigenvectors_device~2~~CallsGraph proc~compute_eigenvectors_device~2 compute_eigenvectors_device proc~compute_roe_average_device~2 compute_roe_average_device proc~compute_eigenvectors_device~2->proc~compute_roe_average_device~2 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~compute_eigenvectors_device~2~~CalledByGraph proc~compute_eigenvectors_device~2 compute_eigenvectors_device proc~compute_fluxes_convective_device~2 compute_fluxes_convective_device proc~compute_fluxes_convective_device~2->proc~compute_eigenvectors_device~2 proc~compute_fluxes_convective_gmp compute_fluxes_convective_gmp proc~compute_fluxes_convective_gmp->proc~compute_fluxes_convective_device~2 proc~compute_residuals~4 nasto_gmp_object%compute_residuals proc~compute_residuals~4->proc~compute_fluxes_convective_gmp proc~integrate~4 nasto_gmp_object%integrate proc~integrate~4->proc~compute_residuals~4 proc~simulate~4 nasto_gmp_object%simulate proc~simulate~4->proc~integrate~4 program~adam_nasto_gmp adam_nasto_gmp program~adam_nasto_gmp->proc~simulate~4 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_eigenvectors_device ( si , sir , b , i , j , k , ngc , nv , g , q_aux_gpu , el , er ) ! Compute eigenvectors centered in inteface i,j,k/ip,jp,kp. integer ( I4P ), intent ( in ) :: si ( 3 ) !< Stencil increment. real ( R8P ), intent ( in ) :: sir ( 3 ) !< Stencil increment, real cast. integer ( I4P ), intent ( in ) :: b , i , j , k !< Cell indexes. integer ( I4P ), intent ( in ) :: ngc !< Ghost cells number. integer ( I4P ), intent ( in ) :: nv !< Number of conservative varibales. real ( R8P ), intent ( in ) :: g !< Specific heats ratio. real ( R8P ), intent ( in ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( inout ) :: el ( 1 : nv , 1 : nv ), er ( 1 : nv , 1 : nv ) !< Left and right eigenvectors. real ( R8P ) :: uu , vv , ww , h , qq , c , ci , b1 , b2 !< Roe average states. real ( R8P ) :: uvw , uvw_r1 , uvw_r2 !< Velocity rotation accordingly dir. !$omp declare target(compute_eigenvectors_device) call compute_roe_average_device ( q_aux_gpu = q_aux_gpu , g = g , ngc = ngc , b = b , i = i , j = j , k = k , ip = i + si ( 1 ), jp = j + si ( 2 ), kp = k + si ( 3 ), & uu = uu , vv = vv , ww = ww , h = h , qq = qq , c = c , ci = ci , b1 = b1 , b2 = b2 ) uvw = uu * sir ( 1 ) + vv * sir ( 2 ) + ww * sir ( 3 ) uvw_r1 = uu * sir ( 3 ) + vv * sir ( 1 ) + ww * sir ( 2 ) uvw_r2 = - uu * sir ( 2 ) + vv * sir ( 3 ) + ww * sir ( 1 ) er ( 1 , 1 ) = 1._R8P ; er ( 1 , 2 ) = uu - c * sir ( 1 ) ; er ( 1 , 3 ) = vv - c * sir ( 2 ) ; er ( 1 , 4 ) = ww - c * sir ( 3 ) ; er ( 1 , 5 ) = h - uvw * c er ( 2 , 1 ) = 1._R8P ; er ( 2 , 2 ) = uu ; er ( 2 , 3 ) = vv ; er ( 2 , 4 ) = ww ; er ( 2 , 5 ) = qq er ( 3 , 1 ) = 1._R8P ; er ( 3 , 2 ) = uu + c * sir ( 1 ) ; er ( 3 , 3 ) = vv + c * sir ( 2 ) ; er ( 3 , 4 ) = ww + c * sir ( 3 ) ; er ( 3 , 5 ) = h + uvw * c er ( 4 , 1 ) = 0._R8P ; er ( 4 , 2 ) = sir ( 2 ) + sir ( 3 ) ; er ( 4 , 3 ) = sir ( 1 ) ; er ( 4 , 4 ) = 0._R8P ; er ( 4 , 5 ) = uvw_r1 er ( 5 , 1 ) = 0._R8P ; er ( 5 , 2 ) = 0._R8P ; er ( 5 , 3 ) = sir ( 3 ) ; er ( 5 , 4 ) = sir ( 1 ) + sir ( 2 ) ; er ( 5 , 5 ) = uvw_r2 el ( 1 , 1 ) = 0.5_R8P * ( b1 + uvw * ci ) ; el ( 1 , 2 ) = 1._R8P - b1 ; el ( 1 , 3 ) = 0.5_R8P * ( b1 - uvw * ci ) ; el ( 1 , 4 ) =- uvw_r1 ; el ( 1 , 5 ) =- uvw_r2 el ( 2 , 1 ) =- 0.5_R8P * ( b2 * uu + ci * sir ( 1 )); el ( 2 , 2 ) = b2 * uu ; el ( 2 , 3 ) =- 0.5_R8P * ( b2 * uu - ci * sir ( 1 )); el ( 2 , 4 ) = sir ( 3 ); el ( 2 , 5 ) =- sir ( 2 ) el ( 3 , 1 ) =- 0.5_R8P * ( b2 * vv + ci * sir ( 2 )); el ( 3 , 2 ) = b2 * vv ; el ( 3 , 3 ) =- 0.5_R8P * ( b2 * vv - ci * sir ( 2 )); el ( 3 , 4 ) = sir ( 1 ); el ( 3 , 5 ) = sir ( 3 ) el ( 4 , 1 ) =- 0.5_R8P * ( b2 * ww + ci * sir ( 3 )); el ( 4 , 2 ) = b2 * ww ; el ( 4 , 3 ) =- 0.5_R8P * ( b2 * ww - ci * sir ( 3 )); el ( 4 , 4 ) = sir ( 2 ); el ( 4 , 5 ) = sir ( 1 ) el ( 5 , 1 ) = 0.5_R8P * b2 ; el ( 5 , 2 ) =- b2 ; el ( 5 , 3 ) = 0.5_R8P * b2 ; el ( 5 , 4 ) = 0._R8P ; el ( 5 , 5 ) = 0._R8P endsubroutine compute_eigenvectors_device","tags":"","url":"proc/compute_eigenvectors_device~2.html"},{"title":"compute_q_aux_gmp – ADAM","text":"public  subroutine compute_q_aux_gmp(ni, nj, nk, ngc, blocks_number, R, cv, g, q_gpu, q_aux_gpu) Compute auxiliary variables. Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: ni Grid cells number in I direction. integer(kind=I4P), intent(in) :: nj Grid cells number in J direction. integer(kind=I4P), intent(in) :: nk Grid cells number in K direction. integer(kind=I4P), intent(in) :: ngc Ghost cells number. integer(kind=I4P), intent(in) :: blocks_number Number of blocks. real(kind=R8P), intent(in) :: R Fluid constant, specific heats difference. real(kind=R8P), intent(in) :: cv Specific heat at constant volume. real(kind=R8P), intent(in) :: g Specific heats ratio. real(kind=R8P), intent(in) :: q_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Conservative variables. real(kind=R8P), intent(out) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. Called by proc~~compute_q_aux_gmp~~CalledByGraph proc~compute_q_aux_gmp compute_q_aux_gmp proc~compute_q_auxiliary~4 nasto_gmp_object%compute_q_auxiliary proc~compute_q_auxiliary~4->proc~compute_q_aux_gmp proc~compute_dt~4 nasto_gmp_object%compute_dt proc~compute_dt~4->proc~compute_q_auxiliary~4 proc~compute_residuals~4 nasto_gmp_object%compute_residuals proc~compute_residuals~4->proc~compute_q_auxiliary~4 proc~copy_gpu_cpu~3 nasto_gmp_object%copy_gpu_cpu proc~copy_gpu_cpu~3->proc~compute_q_auxiliary~4 proc~mark_by_grad_var~4 nasto_gmp_object%mark_by_grad_var proc~mark_by_grad_var~4->proc~compute_q_auxiliary~4 proc~amr_update~4 nasto_gmp_object%amr_update proc~amr_update~4->proc~copy_gpu_cpu~3 proc~amr_update~4->proc~mark_by_grad_var~4 proc~integrate~4 nasto_gmp_object%integrate proc~integrate~4->proc~compute_residuals~4 proc~save_simulation_data~4 nasto_gmp_object%save_simulation_data proc~save_simulation_data~4->proc~copy_gpu_cpu~3 proc~simulate~4 nasto_gmp_object%simulate proc~simulate~4->proc~compute_dt~4 proc~simulate~4->proc~amr_update~4 proc~simulate~4->proc~integrate~4 proc~simulate~4->proc~save_simulation_data~4 program~adam_nasto_gmp adam_nasto_gmp program~adam_nasto_gmp->proc~simulate~4 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_q_aux_gmp ( ni , nj , nk , ngc , blocks_number , R , cv , g , q_gpu , q_aux_gpu ) !< Compute auxiliary variables. integer ( I4P ), intent ( in ) :: ni !< Grid cells number in I direction. integer ( I4P ), intent ( in ) :: nj !< Grid cells number in J direction. integer ( I4P ), intent ( in ) :: nk !< Grid cells number in K direction. integer ( I4P ), intent ( in ) :: ngc !< Ghost cells number. integer ( I4P ), intent ( in ) :: blocks_number !< Number of blocks. real ( R8P ), intent ( in ) :: R !< Fluid constant, specific heats difference. real ( R8P ), intent ( in ) :: cv !< Specific heat at constant volume. real ( R8P ), intent ( in ) :: g !< Specific heats ratio. real ( R8P ), intent ( in ) :: q_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Conservative variables. real ( R8P ), intent ( out ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. integer ( I4P ) :: b , i , j , k , s !< Counter. real ( R8P ) :: rho , uuu , vvv , www , rhe , tem !< State variables. !$omp target teams distribute parallel do collapse(4) has_device_addr(q_gpu,q_aux_gpu) do k = 1 - ngc , nk + ngc do j = 1 - ngc , nj + ngc do i = 1 - ngc , ni + ngc do b = 1 , blocks_number rho = q_gpu ( b , i , j , k , 1 ) uuu = q_gpu ( b , i , j , k , 2 ) / rho vvv = q_gpu ( b , i , j , k , 3 ) / rho www = q_gpu ( b , i , j , k , 4 ) / rho rhe = q_gpu ( b , i , j , k , 5 ) tem = ( rhe / rho - 0.5 * ( uuu ** 2 + vvv ** 2 + www ** 2 )) / cv q_aux_gpu ( b , i , j , k , 1 ) = rho ! density q_aux_gpu ( b , i , j , k , 2 ) = uuu ! velocity x q_aux_gpu ( b , i , j , k , 3 ) = vvv ! velocity y q_aux_gpu ( b , i , j , k , 4 ) = www ! velocity z q_aux_gpu ( b , i , j , k , 5 ) = 0._R8P ! mass fraction q_aux_gpu ( b , i , j , k , 6 ) = tem ! temperature q_aux_gpu ( b , i , j , k , 7 ) = R * rho * tem ! pressure q_aux_gpu ( b , i , j , k , 8 ) = rhe / rho + R * tem ! entalpy q_aux_gpu ( b , i , j , k , 9 ) = sqrt ( g * R * tem ) ! sound speed enddo enddo enddo enddo endsubroutine compute_q_aux_gmp","tags":"","url":"proc/compute_q_aux_gmp.html"},{"title":"compute_roe_average_device – ADAM","text":"private  subroutine compute_roe_average_device(ngc, b, i, j, k, ip, jp, kp, g, q_aux_gpu, uu, vv, ww, h, qq, c, ci, b1, b2) Compute Roe averaged quantities. Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: ngc Number of ghost cells. integer(kind=I4P), intent(in) :: b Left/right cells indexes. integer(kind=I4P), intent(in) :: i Left/right cells indexes. integer(kind=I4P), intent(in) :: j Left/right cells indexes. integer(kind=I4P), intent(in) :: k Left/right cells indexes. integer(kind=I4P), intent(in) :: ip Left/right cells indexes. integer(kind=I4P), intent(in) :: jp Left/right cells indexes. integer(kind=I4P), intent(in) :: kp Left/right cells indexes. real(kind=R8P), intent(in) :: g Specific heats ratio. real(kind=R8P), intent(in) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(out) :: uu Roe state average variables. real(kind=R8P), intent(out) :: vv Roe state average variables. real(kind=R8P), intent(out) :: ww Roe state average variables. real(kind=R8P), intent(out) :: h Roe state average variables. real(kind=R8P), intent(out) :: qq Roe state average variables. real(kind=R8P), intent(out) :: c Roe state average variables. real(kind=R8P), intent(out) :: ci Roe state average variables. real(kind=R8P), intent(out) :: b1 Roe state average variables. real(kind=R8P), intent(out) :: b2 Roe state average variables. Called by proc~~compute_roe_average_device~2~~CalledByGraph proc~compute_roe_average_device~2 compute_roe_average_device proc~compute_eigenvectors_device~2 compute_eigenvectors_device proc~compute_eigenvectors_device~2->proc~compute_roe_average_device~2 proc~compute_fluxes_convective_device~2 compute_fluxes_convective_device proc~compute_fluxes_convective_device~2->proc~compute_eigenvectors_device~2 proc~compute_fluxes_convective_gmp compute_fluxes_convective_gmp proc~compute_fluxes_convective_gmp->proc~compute_fluxes_convective_device~2 proc~compute_residuals~4 nasto_gmp_object%compute_residuals proc~compute_residuals~4->proc~compute_fluxes_convective_gmp proc~integrate~4 nasto_gmp_object%integrate proc~integrate~4->proc~compute_residuals~4 proc~simulate~4 nasto_gmp_object%simulate proc~simulate~4->proc~integrate~4 program~adam_nasto_gmp adam_nasto_gmp program~adam_nasto_gmp->proc~simulate~4 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_roe_average_device ( ngc , b , i , j , k , ip , jp , kp , g , q_aux_gpu , & uu , vv , ww , h , qq , c , ci , b1 , b2 ) !< Compute Roe averaged quantities. integer ( I4P ), intent ( in ) :: ngc !< Number of ghost cells. integer ( I4P ), intent ( in ) :: b , i , j , k , ip , jp , kp !< Left/right cells indexes. real ( R8P ), intent ( in ) :: g !< Specific heats ratio. real ( R8P ), intent ( in ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( out ) :: uu , vv , ww , h , qq , c , ci , b1 , b2 !< Roe state average variables. real ( R8P ) :: ri , up , vp , wp , hp , r , rp1 , cc !< Local varbiables. !$omp declare target(compute_roe_average_device) ! left state (node i) ri = 1._R8P / q_aux_gpu ( b , i , j , k , 1 ) uu = q_aux_gpu ( b , i , j , k , 2 ) vv = q_aux_gpu ( b , i , j , k , 3 ) ww = q_aux_gpu ( b , i , j , k , 4 ) h = q_aux_gpu ( b , i , j , k , 8 ) ! right state (node i+1) up = q_aux_gpu ( b , ip , jp , kp , 2 ) vp = q_aux_gpu ( b , ip , jp , kp , 3 ) wp = q_aux_gpu ( b , ip , jp , kp , 4 ) hp = q_aux_gpu ( b , ip , jp , kp , 8 ) ! Roe average state r = sqrt ( q_aux_gpu ( b , ip , jp , kp , 1 ) * ri ) rp1 = 1._R8P / ( r + 1._R8P ) uu = ( r * up + uu ) * rp1 vv = ( r * vp + vv ) * rp1 ww = ( r * wp + ww ) * rp1 h = ( r * hp + h ) * rp1 qq = 0.5_R8P * ( uu * uu + vv * vv + ww * ww ) cc = ( g - 1._R8P ) * ( h - qq ) c = sqrt ( cc ) ci = 1._R8P / c b2 = ( g - 1 ) / cc ! alias 1/(cp*theta) b1 = b2 * qq ! alias q/(cp*theta) endsubroutine compute_roe_average_device","tags":"","url":"proc/compute_roe_average_device~2.html"},{"title":"initialize – ADAM","text":"private  subroutine initialize(self, file_parameters) Initialize the equation. Type Bound nasto_bc_object Arguments Type Intent Optional Attributes Name class( nasto_bc_object ), intent(inout) :: self BC. type(file_ini), intent(in) :: file_parameters Simulation parameters ini file handler. Calls proc~~initialize~3~~CallsGraph proc~initialize~3 nasto_bc_object%initialize initialize initialize proc~initialize~3->initialize proc~load_from_file~2 nasto_bc_object%load_from_file proc~initialize~3->proc~load_from_file~2 error_stop error_stop proc~load_from_file~2->error_stop get get proc~load_from_file~2->get Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an