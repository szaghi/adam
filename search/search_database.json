% refinements_needed ( b ), TO_BE_DEREFINED ) else self % field % refinements_needed ( b ) = max ( self % field % refinements_needed ( b ), TO_NOT_TOUCH ) endif enddo endassociate contains function max_cell_delta_dist ( distance ) result ( delta ) !< Return the maximum cell delta given a comparison distance. real ( R8P ), intent ( in ) :: distance !< Comparison distance. real ( R8P ) :: delta !< Maximum cell delta admissible. if ( abs ( distance ) < epsilon ( 0._R8P )) then delta = delta_fine else delta = delta_coarse endif endfunction max_cell_delta_dist endsubroutine mark_by_geo","tags":"","url":"proc/mark_by_geo~4.html"},{"title":"mark_by_grad_var – ADAM","text":"private  subroutine mark_by_grad_var(self, grad_tol, delta_fine, delta_coarse, ivar, threshold, do_init) Mark blocks to be refined/derefined by a grad(var) value. Type Bound nasto_gmp_object Arguments Type Intent Optional Attributes Name class( nasto_gmp_object ), intent(inout) :: self The equation. real(kind=R8P), intent(in) :: grad_tol Gradiend tolerance value. real(kind=R8P), intent(in) :: delta_fine Maximum cell delta in fine grids. real(kind=R8P), intent(in) :: delta_coarse Minimum cell delta in coarse grids. integer(kind=I4P), intent(in), optional :: ivar Variable for marking. real(kind=R8P), intent(in), optional :: threshold Threshold for sphere proximity. logical, intent(in), optional :: do_init Re-initialize refinements queries. Calls proc~~mark_by_grad_var~4~~CallsGraph proc~mark_by_grad_var~4 nasto_gmp_object%mark_by_grad_var compute_q_gradient compute_q_gradient proc~mark_by_grad_var~4->compute_q_gradient dxyz dxyz proc~mark_by_grad_var~4->dxyz proc~compute_q_auxiliary~4 nasto_gmp_object%compute_q_auxiliary proc~mark_by_grad_var~4->proc~compute_q_auxiliary~4 proc~update_ghost~4 nasto_gmp_object%update_ghost proc~mark_by_grad_var~4->proc~update_ghost~4 refinements_needed refinements_needed proc~mark_by_grad_var~4->refinements_needed proc~compute_q_aux_gmp compute_q_aux_gmp proc~compute_q_auxil