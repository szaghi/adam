1 : 5 , 1 : 5 ) !< Left and right eigenvectors. real ( R8P ) :: uu , vv , ww , h , qq , c , ci , b1 , b2 !< Roe average states. real ( R8P ) :: uvw , uvw_r1 , uvw_r2 !< Velocity rotation accordingly dir. !$acc routine(compute_eigenvectors_dev) !$omp declare target(compute_eigenvectors_dev) call compute_roe_average_device ( q_aux_gpu = q_aux_gpu , g = g , ngc = ngc , b = b , i = i , j = j , k = k , ip = i + si ( 1 ), jp = j + si ( 2 ), kp = k + si ( 3 ), & uu = uu , vv = vv , ww = ww , h = h , qq = qq , c = c , ci = ci , b1 = b1 , b2 = b2 ) uvw = uu * sir ( 1 ) + vv * sir ( 2 ) + ww * sir ( 3 ) uvw_r1 = uu * sir ( 3 ) + vv * sir ( 1 ) + ww * sir ( 2 ) uvw_r2 = - uu * sir ( 2 ) + vv * sir ( 3 ) + ww * sir ( 1 ) er ( 1 , 1 ) = 1._R8P ; er ( 1 , 2 ) = uu - c * sir ( 1 ) ; er ( 1 , 3 ) = vv - c * sir ( 2 ) ; er ( 1 , 4 ) = ww - c * sir ( 3 ) ; er ( 1 , 5 ) = h - uvw * c er ( 2 , 1 ) = 1._R8P ; er ( 2 , 2 ) = uu ; er ( 2 , 3 ) = vv ; er ( 2 , 4 ) = ww ; er ( 2 , 5 ) = qq er ( 3 , 1 ) = 1._R8P ; er ( 3 , 2 ) = uu + c * sir ( 1 ) ; er ( 3 , 3 ) = vv + c * sir ( 2 ) ; er ( 3 , 4 ) = ww + c * sir ( 3 ) ; er ( 3 , 5 ) = h + uvw * c er ( 4 , 1 ) = 0._R8P ; er ( 4 , 2 ) = sir ( 2 ) + sir ( 3 ) ; er ( 4 , 3 ) = sir ( 1 ) ; er ( 4 , 4 ) = 0._R8P ; er ( 4 , 5 ) = uvw_r1 er ( 5 , 1 ) = 0._R8P ; er ( 5 , 2 ) = 0._R8P ; er ( 5 , 3 ) = sir ( 3 ) ; er ( 5 , 4 ) = sir ( 1 ) + sir ( 2 ) ; er ( 5 , 5 ) = uvw_r2 el ( 1 , 1 ) = 0.5_R8P * ( b1 + uvw * ci ) ; el ( 1 , 2 ) = 1._R8P - b1 ; el ( 1 , 3 ) = 0.5_R8P * ( b1 - uvw * ci ) ; el ( 1 , 4 ) =- uvw_r1 ; el ( 1 , 5 ) =- uvw_r2 el ( 2 , 1 ) =- 0.5_R8P * ( b2 * uu + ci * sir ( 1 )); el ( 2 , 2 ) = b2 * uu ; el ( 2 , 3 ) =- 0.5_R8P * ( b2 * uu - ci * sir ( 1 )); el ( 2 , 4 ) = sir ( 3 ); el ( 2 , 5 ) =- sir ( 2 ) el ( 3 , 1 ) =- 0.5_R8P * ( b2 * vv + ci * sir ( 2 )); el ( 3 , 2 ) = b2 * vv ; el ( 3 , 3 ) =- 0.5_R8P * ( b2 * vv - ci * sir ( 2 )); el ( 3 , 4 ) = sir ( 1 ); el ( 3 , 5 ) = sir ( 3 ) el ( 4 , 1 ) =- 0.5_R8P * ( b2 * ww + ci * sir ( 3 )); el ( 4 , 2 ) = b2 * ww ; el ( 4 , 3 ) =- 0.5_R8P * ( b2 * ww - ci * sir ( 3 )); el ( 4 , 4 ) = sir ( 2 ); el ( 4 , 5 ) = sir ( 1 ) el ( 5 , 1 ) = 0.5_R8P * b2 ; el ( 5 , 2 ) =- b2 ; el ( 5 , 3 ) = 0.5_R8P * b2 ; el ( 5 , 4 ) = 0._R8P ; el ( 5 , 5 ) = 0._R8P endsubroutine compute_eigenvectors_dev","tags":"","url":"proc/compute_eigenvectors_dev.html"},{"title":"compute_q_aux_dev – ADAM","text":"public  subroutine compute_q_aux_dev(ni, nj, nk, ngc, blocks_number, R, cv, g, q_gpu, q_aux_gpu) Compute auxiliary variables. Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: ni Grid cells number in I direction. integer(kind=I4P), intent(in) :: nj Grid cells number in J direction. integer(kind=I4P), intent(in) :: nk Grid cells number in K direction. integer(kind=I4P), intent(in) :: ngc Ghost cells number. integer(kind=I4P), intent(in) :: blocks_number Number of blocks. real(kind=R8P), intent(in) :: R Fluid constant, specific heats difference. real(kind=R8P), intent(in) :: cv Specific heat at constant volume. real(kind=R8P), intent(in) :: g Specific heats ratio. real(kind=R8P), intent(in) :: q_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Conservative variables. real(kind=R8P), intent(out) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. Called by proc~~compute_q_aux_dev~~CalledByGraph proc~compute_q_aux_dev compute_q_aux_dev proc~compute_q_auxiliary~3 nasto_fnl_object%compute_q_auxiliary proc~compute_q_auxiliary~3->proc~compute_q_aux_dev proc~compute_dt~3 nasto_fnl_object%compute_dt proc~compute_dt~3->proc~compute_q_auxiliary~3 proc~compute_residuals~3 nasto_fnl_object%compute_residuals proc~compute_residuals~3->proc~compute_q_auxiliary~3 proc~copy_gpu_cpu~2 nasto_fnl_object%copy_gpu_cpu proc~copy_gpu_cpu~2->proc~compute_q_auxiliary~3 proc~mark_by_grad_var~3 nasto_fnl_object%mark_by_grad_var proc~mark_by_grad_var~3->proc~compute_q_auxiliary~3 proc~amr_update~3 nasto_fnl_object%amr_update proc~amr_update~3->proc~copy_gpu_cpu~2 proc~amr_update~3->proc~mark_by_grad_var~3 proc~integrate~3 nasto_fnl_object%integrate proc~integrate~3->proc~compute_residuals~3 proc~save_simulation_data~3 nasto_fnl_object%save_simulation_data proc~save_simulation_data~3->proc~copy_gpu_cpu~2 proc~simulate~3 nasto_fnl_object%simulate proc~simulate~3->proc~compute_dt~3 proc~simulate~3->proc~amr_update~3 proc~simulate~3->proc~integrate~3 proc~simulate~3->proc~save_simulation_data~3 program~adam_nasto_fnl adam_nasto_fnl program~adam_nasto_fnl->proc~simulate~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_q_aux_dev ( ni , nj , nk , ngc , blocks_number , R , cv , g , q_gpu , q_aux_gpu ) !< Compute auxiliary variables. integer ( I4P ), intent ( in ) :: ni !< Grid cells number in I direction. integer ( I4P ), intent ( in ) :: nj !< Grid cells number in J direction. integer ( I4P ), intent ( in ) :: nk !< Grid cells number in K direction. integer ( I4P ), intent ( in ) :: ngc !< Ghost cells number. integer ( I4P ), intent ( in ) :: blocks_number !< Number of blocks. real ( R8P ), intent ( in ) :: R !< Fluid constant, specific heats difference. real ( R8P ), intent ( in ) :: cv !< Specific heat at constant volume. real ( R8P ), intent ( in ) :: g !< Specific heats ratio. real ( R8P ), intent ( in ) :: q_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Conservative variables. real ( R8P ), intent ( out ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. integer ( I4P ) :: b , i , j , k , s !< Counter. real ( R8P ) :: rho , uuu , vvv , www , rhe , tem !< State variables. !$acc parallel loop independent DEVICEVAR(q_gpu, q_aux_gpu) !$omp OMPLOOP DEVICEVAR(q_gpu, q_aux_gpu) do k = 1 - ngc , nk + ngc do j = 1 - ngc , nj + ngc do i = 1 - ngc , ni + ngc do b = 1 , blocks_number rho = q_gpu ( b , i , j , k , 1 ) uuu = q_gpu ( b , i , j , k , 2 ) / rho vvv = q_gpu ( b , i , j , k , 3 ) / rho www = q_gpu ( b , i , j , k , 4 ) / rho rhe = q_gpu ( b , i , j , k , 5 ) tem = ( rhe / rho - 0.5 * ( uuu ** 2 + vvv ** 2 + www ** 2 )) / cv q_aux_gpu ( b , i , j , k , 1 ) = rho ! density q_aux_gpu ( b , i , j , k , 2 ) = uuu ! velocity x q_aux_gpu ( b , i , j , k , 3 ) = vvv ! velocity y q_aux_gpu ( b , i , j , k , 4 ) = www ! velocity z q_aux_gpu ( b , i , j , k , 5 ) = 0._R8P ! mass fraction q_aux_gpu ( b , i , j , k , 6 ) = tem ! temperature q_aux_gpu ( b , i , j , k , 7 ) = R * rho * tem ! pressure q_aux_gpu ( b , i , j , k , 8 ) = rhe / rho + R * tem ! entalpy q_aux_gpu ( b , i , j , k , 9 ) = sqrt ( g * R * tem ) ! sound speed enddo enddo enddo enddo endsubroutine compute_q_aux_dev","tags":"","url":"proc/compute_q_aux_dev.html"},{"title":"compute_roe_average_device – ADAM","text":"private  subroutine compute_roe_average_device(ngc, b, i, j, k, ip, jp, kp, g, q_aux_gpu, uu, vv, ww, h, qq, c, ci, b1, b2) Compute Roe averaged quantities. Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: ngc Number of ghost cells. integer(kind=I4P), intent(in) :: b Left/right cells indexes. integer(kind=I4P), intent(in) :: i Left/right cells indexes. integer(kind=I4P), intent(in) :: j Left/right cells indexes. integer(kind=I4P), intent(in) :: k Left/right cells indexes. integer(kind=I4P), intent(in) :: ip Left/right cells indexes. integer(kind=I4P), intent(in) :: jp Left/right cells indexes. integer(kind=I4P), intent(in) :: kp Left/right cells indexes. real(kind=R8P), intent(in) :: g Specific heats ratio. real(kind=R8P), intent(in) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(out) :: uu Roe state average variables. real(kind=R8P), intent(out) :: vv Roe state average variables. real(kind=R8P), intent(out) :: ww Roe state average variables. real(kind=R8P), intent(out) :: h Roe state average variables. real(kind=R8P), intent(out) :: qq Roe state average variables. real(kind=R8P), intent(out) :: c Roe state average variables. real(kind=R8P), intent(out) :: ci Roe state average variables. real(kind=R8P), intent(out) :: b1 Roe state average variables. real(kind=R8P), intent(out) :: b2 Roe state average variables. Called by proc~~compute_roe_average_device~3~~CalledByGraph proc~compute_roe_average_device~3 compute_roe_average_device proc~compute_eigenvectors_dev compute_eigenvectors_dev proc~compute_eigenvectors_dev->proc~compute_roe_average_device~3 proc~compute_fluxes_convective_ri_dev compute_fluxes_convective_ri_dev proc~compute_fluxes_convective_ri_dev->proc~compute_eigenvectors_dev proc~compute_fluxes_convective_dev compute_fluxes_convective_dev proc~compute_fluxes_convective_dev->proc~compute_fluxes_convective_ri_dev proc~compute_residuals~3 nasto_fnl_object%compute_residuals proc~compute_residuals~3->proc~compute_fluxes_convective_dev proc~integrate~3 nasto_fnl_object%integrate proc~integrate~3->proc~compute_residuals~3 proc~simulate~3 nasto_fnl_object%simulate proc~simulate~3->proc~integrate~3 program~adam_nasto_fnl adam_nasto_fnl program~adam_nasto_fnl->proc~simulate~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_roe_average_device ( ngc , b , i , j , k , ip , jp , kp , g , q_aux_gpu , uu , vv , ww , h , qq , c , ci , b1 , b2 ) !< Compute Roe averaged quantities. integer ( I4P ), intent ( in ) :: ngc !< Number of ghost cells. integer ( I4P ), intent ( in ) :: b , i , j , k , ip , jp , kp !< Left/right cells indexes. real ( R8P ), intent ( in ) :: g !< Specific heats ratio. real ( R8P ), intent ( in ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( out ) :: uu , vv , ww , h , qq , c , ci , b1 , b2 !< Roe state average variables. real ( R8P ) :: ri , up , vp , wp , hp , r , rp1 , cc !< Local varbiables. !$acc routine(compute_roe_average_device) !$omp declare target(compute_roe_average_device) ! left state (node i) ri = 1._R8P / q_aux_gpu ( b , i , j , k , 1 ) uu = q_aux_gpu ( b , i , j , k , 2 ) vv = q_aux_gpu ( b , i , j , k , 3 ) ww = q_aux_gpu ( b , i , j , k , 4 ) h = q_aux_gpu ( b , i , j , k , 8 ) ! right state (node i+1) up = q_aux_gpu ( b , ip , jp , kp , 2 ) vp = q_aux_gpu ( b , ip , jp , kp , 3 ) wp = q_aux_gpu ( b , ip , jp , kp , 4 ) hp = q_aux_gpu ( b , ip , jp , kp , 8 ) ! Roe average state r = sqrt ( q_aux_gpu ( b , ip , jp , kp , 1 ) * ri ) rp1 = 1._R8P / ( r + 1._R8P ) uu = ( r * up + uu ) * rp1 vv = ( r * vp + vv ) * rp1 ww = ( r * wp + ww ) * rp1 h = ( r * hp + h ) * rp1 qq = 0.5_R8P * ( uu * uu + vv * vv + ww * ww ) cc = ( g - 1._R8P ) * ( h - qq ) c = sqrt ( cc ) ci = 1._R8P / c b2 = ( g - 1 ) / cc ! alias 1/(cp*theta) b1 = b2 * qq ! alias q/(cp*theta) endsubroutine compute_roe_average_device","tags":"","url":"proc/compute_roe_average_device~3.html"},{"title":"description – ADAM","text":"private pure function description(self) result(desc) Return a pretty-formatted object description. Type Bound nasto_ic_object Arguments Type Intent Optional Attributes Name class( nasto_ic_object ), intent(in) :: 