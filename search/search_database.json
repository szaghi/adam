 sir ( 3 ) !< Stencil increment, real cast. integer ( I4P ) :: b , i , j , k !< Counter. integer ( I4P ) :: ierr !< Error status. select case ( dir ) case ( 1 ) si = [ 1 , 0 , 0 ] sir = [ 1._R8P , 0._R8P , 0._R8P ] !$acc parallel loop independent DEVICEVAR(weno_a_gpu,weno_p_gpu,weno_d_gpu,ror_ivar_gpu,ror_stats_gpu,ror_schemes_gpu, & !$acc                                     q_aux_gpu,fluxes_gpu,si,sir) !$omp OMPLOOP DEVICEVAR(weno_a_gpu,weno_p_gpu,weno_d_gpu,ror_ivar_gpu,ror_stats_gpu,ror_schemes_gpu, & !$omp                   q_aux_gpu,fluxes_gpu,si,sir) do b = 1 , blocks_number do k = 1 , nk do j = 1 , nj do i = 0 , ni call compute_fluxes_convective_ri_dev ( dir = dir , si = si , sir = sir , b = b , i = i , j = j , k = k , ngc = ngc , nv = nv , & weno_s = weno_s , weno_a_gpu = weno_a_gpu , weno_p_gpu = weno_p_gpu , & weno_d_gpu = weno_d_gpu , weno_zeps = weno_zeps , & ror_number = ror_number , ror_schemes_gpu = ror_schemes_gpu , & ror_threshold = ror_threshold , ror_ivar_gpu = ror_ivar_gpu , & ror_stats_gpu = ror_stats_gpu , & g = g , q_aux_gpu = q_aux_gpu , fluxes_gpu = fluxes_gpu ) enddo enddo enddo enddo case ( 2 ) si = [ 0 , 1 , 0 ] sir = [ 0._R8P , 1._R8P , 0._R8P ] !$acc parallel loop independent DEVICEVAR(weno_a_gpu,weno_p_gpu,weno_d_gpu,ror_ivar_gpu,ror_stats_gpu,ror_schemes_gpu, & !$acc                                     q_aux_gpu,fluxes_gpu,si,sir) !$omp OMPLOOP DEVICEVAR(weno_a_gpu,weno_p_gpu,weno_d_gpu,ror_ivar_gpu,ror_stats_gpu,ror_schemes_gpu, & !$omp                   q_aux_gpu,fluxes_gpu,si,sir) do b = 1 , blocks_number do k = 1 , nk do i = 1 , ni do j = 0 , nj call compute_fluxes_convective_ri_dev ( dir = dir , si = si , sir = sir , b = b , i = i , j = j , k = k , ngc = ngc , nv = nv , & weno_s = weno_s , weno_a_gpu = weno_a_gpu , weno_p_gpu = weno_p_gpu , & weno_d_gpu = weno_d_gpu , weno_zeps = weno_zeps , & ror_number = ror_number , ror_schemes_gpu = ror_schemes_gpu , & ror_threshold = ror_threshold , ror_ivar_gpu = ror_ivar_gpu , & ror_stats_