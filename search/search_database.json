( R8P ), intent ( in ) :: el ( 1 :, 1 :) !< Left eigeinvectors. integer ( I4P ), intent ( in ) :: weno_s !< Weno stencils number/dimension. integer ( I4P ), intent ( in ) :: b , i , j , k !< Counter. integer ( I4P ), intent ( in ) :: ngc !< Ghost cells number. integer ( I4P ), intent ( in ) :: nv !< Number of conservative varibales. real ( R8P ), intent ( in ) :: g !< Specific heats ratio. real ( R8P ), intent ( in ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( inout ) :: fmpc ( 1 :, 1 - weno_s :, 1 :) !< Fluxes -+ decomposition in characteristics space. real ( R8P ) :: fmp ( 2 ) !< Fluxes -+ decomposition in each cell stencils. real ( R8P ) :: evmax ( 5 ) !< Signals speeds. real ( R8P ) :: q ( 5 ), f ( 5 ) !< Conservative variables and fluxes. real ( R8P ) :: gc , wc !< Increments for fluxes decomposition. integer ( I4P ) :: v , vv , s , is , js , ks !< Counter. !$acc routine(decompose_fluxes_convective_device) !$omp declare target(decompose_fluxes_convective_device) call compute_max_eigenvalues_dev ( si = si , sir = sir , weno_s = weno_s , b = b , i = i , j = j , k = k , ngc = ngc , nv = nv , q_aux_gpu = q_aux_gpu , evmax = evmax ) do s = 1 - weno_s , weno_s is = i + ( s ) * si ( 1 ) ; js = j + ( s ) * si ( 2 ) ; ks = k + ( s ) * si ( 3 ) call compute_conservatives_dev ( b = b , i = is , j = js , k = ks , ngc = ngc , q_aux_gpu = q_aux_gpu , q = q ) call compute_conservative_fluxes_dev ( sir = sir , b = b , i = is , j = js , k = ks , ngc = ngc , q_aux_gpu = q_aux_gpu , f = f ) do v = 1 , nv wc = 0._R8P gc = 0._R8P do vv = 1 , nv wc = wc + el ( vv , v ) * q ( vv ) gc = gc + el ( vv , v ) * f ( vv ) enddo fmp ( 2 ) = 0.5_R8P * ( gc + evmax ( v ) * wc ) fmp ( 1 ) = gc - fmp ( 2 ) ! fmp(2) = 0.5_R8P * (f(v) + 1.2_R8P*evmax(v) * q(v)) ! fmp(1) = f(v) - fmp(2) if ( s < weno_s ) fmpc ( 2 , s , v ) = fmp ( 2 ) if ( s > 1 - weno_s ) fmpc ( 1 , s - 1 , v ) = fmp ( 1 ) enddo enddo endsubroutine decompose_fluxes_convective_device","tags":"","url":"proc/decompose_fluxes_convective_device~3.html"},{"title":"adam_nasto_nvf_cns_kernels – ADAM","text":"ADAM, NASTO NVF Compressible-Navier-Stokes fluidyanmics application kernels. Uses penf cudafor module~~adam_nasto_nvf_cns_kernels~~UsesGraph module~adam_nasto_nvf_cns_kernels adam_nasto_nvf_cns_kernels cudafor cudafor module~adam_nasto_nvf_cns_kernels->cudafor penf penf module~adam_nasto_nvf_cns_kernels->penf Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Used by module~~adam_nasto_nvf_cns_kernels~~UsedByGraph module~adam_nasto_nvf_cns_kernels adam_nasto_nvf_cns_kernels module~adam_nasto_nvf_kernels adam_nasto_nvf_kernels module~adam_nasto_nvf_kernels->module~adam_nasto_nvf_cns_kernels module~adam_nasto_nvf_object adam_nasto_nvf_object module~adam_nasto_nvf_object->module~adam_nasto_nvf_kernels program~adam_nasto_nvf adam_nasto_nvf program~adam_nasto_nvf->module~adam_nasto_nvf_object Help Graph Key Nodes of different colours represent the following: Graph Key Module Module Submodule Submodule Subroutine Subroutine Function Function Program Program This Page's Entity This Page's Entity Solid arrows point from a submodule to the (sub)module which it is\ndescended from. Dashed arrows point from a module or program unit to \nmodules which it uses. Subroutines public  subroutine compute_conservatives_device (b, i, j, k, ngc, q_aux_gpu, q) Compute convervative variables from auxiliary ones. Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in), value :: b Cell indexes. integer(kind=I4P), intent(in), value :: i Cell indexes. integer(kind=I4P), intent(in), value :: j Cell indexes. integer(kind=I4P), intent(