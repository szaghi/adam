v fluxes_gpu ( b , i , j , k , v ) = 0._R8P do vv = 1 , nv fluxes_gpu ( b , i , j , k , v ) = fluxes_gpu ( b , i , j , k , v ) + er ( vv , v ) * ( fpmr ( 1 , vv ) + fpmr ( 2 , vv )) enddo ! fluxes_gpu(b,i,j,k,v) = fluxes_gpu(b,i,j,k,v) + fpmr(1,v) ! fluxes_gpu(b,i,j,k,v) = fluxes_gpu(b,i,j,k,v) + fpmr(2,v) enddo endsubroutine compute_fluxes_convective_ri_dev subroutine decompose_fluxes_convective_device ( si , sir , el , weno_s , b , i , j , k , ngc , nv , g , q_aux_gpu , fmpc ) !< Decompose convective fluxes. !< Flux vector splitting by local-Lax-Friedrics (Rusanov) with projection in pseudo-characteristics psace. integer ( I4P ), intent ( in ) :: si ( 3 ) !< Stencil increment. real ( R8P ), intent ( in ) :: sir ( 3 ) !< Stencil increment, real cast. real ( R8P ), intent ( in ) :: el ( 1 :, 1 :) !< Left eigeinvectors. integer ( I4P ), intent ( in ) :: weno_s !< Weno stencils number/dimension. integer ( I4P ), intent ( in ) :: b , i , j , k !< Counter. integer ( I4P ), intent ( in ) :: ngc !< Ghost cells number. integer ( I4P ), intent ( in ) :: nv !< Number of conservative varibales. real ( R8P ), intent ( in ) :: g !< Specific heats ratio. real ( R8P ), intent ( in ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( inout ) :: fmpc ( 1 :, 1 - weno_s :, 1 :) !< Fluxes -+ decomposition in characteristics space. real ( R8P ) :: fmp ( 2 ) !< Fluxes -+ decomposition in each cell stencils. real ( R8P ) :: evmax ( 5 ) !< Signals speeds. real ( R8P ) :: q ( 5 ), f ( 5 ) !< Conservative variables and fluxes. real ( R8P ) :: gc , wc !< Increments for fluxes decomposition. integer ( I4P ) :: v , vv , s , is , js , ks !< Counter. !$acc routine(decompose_fluxes_convective_device) !$omp declare target(decompose_fluxes_convective_device) call compute_max_eigenvalues_dev ( si = si , sir = sir , weno_s = weno_s , b = b , i = i , j = j , k = k , ngc = ngc , nv = nv , q_aux_gpu = q_aux_gpu , evmax = evmax ) do s = 1 - weno_s , weno_s is = i + ( s ) * si ( 1 ) ; js = j + ( s ) * si ( 2 ) ; ks = k + ( s ) * si ( 3 ) call compute_conservatives_dev ( b = b , i = is , j = js , k = ks , ngc = ngc , q_aux_gpu = q_aux_gpu , q = q ) call compute_conservative_fluxes_dev ( sir = sir , b = b , i = is , j = js , k = ks , ngc = ngc , q_aux_gpu = q_aux_gpu , f = f ) do v = 1 , nv wc = 0._R8P gc = 0._R8P do vv = 1 , nv wc = wc + el ( vv , v ) * q ( vv ) gc = gc + el ( vv , v ) * f ( vv ) enddo fmp ( 2 ) = 0.5_R8P * ( gc + evmax ( v ) * wc ) fmp ( 1 ) = gc - fmp ( 2 ) ! fmp(2) = 0.5_R8P * (f(v) + 1.2_R8P*evmax(v) * q(v)) ! fmp(1) = f(v) - fmp(2) if ( s < weno_s ) fmpc ( 2 , s , v ) = fmp ( 2 ) if ( s > 1 - weno_s ) fmpc ( 1 , s - 1 , v ) = fmp ( 1 ) enddo enddo endsubroutine decompose_fluxes_convective_device endmodule adam_nasto_fnl_kernels","tags":"","url":"sourcefile/adam_nasto_fnl_kernels.f90.html"},{"title":"adam_nasto_fnl.F90 – ADAM","text":"ADAM, Navier-Stokes application solver, GPU (FNL) backend. This file depends on sourcefile~~adam_nasto_fnl.f90~~EfferentGraph sourcefile~adam_nasto_fnl.f90 adam_nasto_fnl.F90 sourcefile~adam_nasto_fnl_object.f90 adam_nasto_fnl_object.F90 sourcefile~adam_nasto_fnl.f90->sourcefile~adam_nasto_fnl_object.f90 sourcefile~adam_nasto_fnl_library.f90 adam_nasto_fnl_library.F90 sourcefile~adam_nasto_fnl_object.f90->sourcefile~adam_nasto_fnl_library.f90 sourcefile~adam_nasto_common_library.f90 adam_nasto_common_library.F90 sourcefile~adam_nasto_fnl_library.f90->sourcefile~adam_nasto_common_library.f90 sourcefile~adam_nasto_fnl_cns_kernels.f90 adam_nasto_fnl_cns_kernels.F90 sourcefile~adam_nasto_fnl_library.f90->sourcefile~adam_nasto_fnl_cns_kernels.f90 sourcefile~adam_nasto_fnl_kernels.f90 adam_nasto_fnl_kernels.F90 sourcefile~adam_nasto_fnl_library.f90->sourcefile~adam_nasto_fnl_kernels.f90 sourcefile~adam_nasto_bc_object.f90 adam_nasto_bc_object.F90 sourcefile~adam_nasto_common_library.f90->sourcefile~adam_nasto_bc_object.f90 sourcefile~adam_nasto_common_object.f90 adam_n