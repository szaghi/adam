Cell indexes. integer(kind=I4P), intent(in) :: k Cell indexes. integer(kind=I4P), intent(in) :: ngc Ghost cells number. real(kind=R8P), intent(in) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(inout) :: q (1:) Conservative varibales. Called by proc~~compute_conservatives_dev~~CalledByGraph proc~compute_conservatives_dev compute_conservatives_dev proc~decompose_fluxes_convective_device~3 decompose_fluxes_convective_device proc~decompose_fluxes_convective_device~3->proc~compute_conservatives_dev proc~compute_fluxes_convective_ri_dev compute_fluxes_convective_ri_dev proc~compute_fluxes_convective_ri_dev->proc~decompose_fluxes_convective_device~3 proc~compute_fluxes_convective_dev compute_fluxes_convective_dev proc~compute_fluxes_convective_dev->proc~compute_fluxes_convective_ri_dev proc~compute_residuals~3 nasto_fnl_object%compute_residuals proc~compute_residuals~3->proc~compute_fluxes_convective_dev proc~integrate~3 nasto_fnl_object%integrate proc~integrate~3->proc~compute_residuals~3 proc~simulate~3 nasto_fnl_object%simulate proc~simulate~3->proc~integrate~3 program~adam_nasto_fnl adam_nasto_fnl program~adam_nasto_fnl->proc~simulate~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_conservatives_dev ( b , i , j , k , ngc , q_aux_gpu , q ) !< Compute convervative variables from auxiliary ones. integer ( I4P ), intent ( in ) :: b , i , j , k !< Cell indexes. integer ( I4P ), intent ( in ) :: ngc !< Ghost cells number. real ( R8P ), intent ( in ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( inout ) :: q ( 1 :) !< Conservative varibales. !$acc routine(compute_conservatives_dev) !$omp declare target(compute_conservatives_dev) q ( 1 ) = q_aux_gpu ( b , i , j , k , 1 ) q ( 2 ) = q ( 1 ) * q_aux_gpu ( b , i , j , k , 2 ) q ( 3 ) = q ( 1 ) * q_aux_gpu ( b , i , j , k , 3 ) q ( 4 ) = q ( 1 ) * q_aux_gpu ( b , i , j , k , 4 ) q ( 5 ) = q ( 1 ) * q_aux_gpu ( b , i , j , k , 8 ) - q_aux_gpu ( b , i , j , k , 7 ) endsubroutine compute_conservatives_dev","tags":"","url":"proc/compute_conservatives_dev.html"},{"title":"compute_conservative_fluxes_dev – ADAM","text":"public  subroutine compute_conservative_fluxes_dev(sir, b, i, j, k, ngc, q_aux_gpu, f) Compute convervative fluxes from auxiliary variables. Arguments Type Intent Optional Attributes Name real(kind=R8P), intent(in) :: sir (3) Directional (1=x,2=y,3=z) increment. integer(kind=I4P), intent(in) :: b Cell indexes. integer(kind=I4P), intent(in) :: i Cell indexes. integer(kind=I4P), intent(in) :: j Cell indexes. integer(kind=I4P), intent(in) :: k Cell indexes. integer(kind=I4P), intent(in) :: ngc Ghost cells number. real(kind=R8P), intent(in) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(inout) :: f (1:) Conservative fluxes. Called by proc~~compute_conservative_fluxes_dev~~CalledByGraph proc~compute_conservative_fluxes_dev compute_conservative_fluxes_dev proc~decompose_fluxes_convective_device~3 decompose_fluxes_convective_device proc~decompose_fluxes_convective_device~3->proc~compute_conservative_fluxes_dev proc~compute_fluxes_convective_ri_dev compute_fluxes_convective_ri_dev proc~compute_fluxes_convective_ri_dev->proc~decompose_fluxes_convective_device~3 proc~compute_fluxes_convective_dev compute_fluxes_convective_dev proc~compute_fluxes_convective_dev->proc~compute_fluxes_convective_ri_dev proc~compute_residuals~3 nasto_fnl_object%compute_residuals proc~compute_residuals~3->proc~compute_fluxes_convective_dev proc~integrate~3 nasto_fnl_object%integrate proc~integrate~3->proc~compute_residuals~3 proc~simulate~3 nasto_fnl_object%simulate proc~simulate~3->proc~integrate~3 program~adam_nasto_fnl adam_nasto_fnl program~adam_nasto_fnl->proc~simulate~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_conservative_fluxes_dev ( sir , b , i , j , k , ngc , q_aux_gpu , f ) !< Compute convervative fluxes from auxiliary variables. real ( R8P ), intent ( in ) :: sir ( 3 ) !< Directional (1=x,2=y,3=z) increment. integer ( I4P ), intent ( in ) :: b , i , j , k !< Cell indexes. integer ( I4P ), intent ( in ) :: ngc !< Ghost cells number. real ( R8P ), intent ( in ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( inout ) :: f ( 1 :) !< Conservative fluxes. !$acc routine(compute_conservative_fluxes_dev) !$omp declare target(compute_conservative_fluxes_dev) f ( 1 ) = q_aux_gpu ( b , i , j , k , 1 ) * q_aux_gpu ( b , i , j , k , 2 ) * sir ( 1 ) + & q_aux_gpu ( b , i , j , k , 1 ) * q_aux_gpu ( b , i , j , k , 3 ) * sir ( 2 ) + & q_aux_gpu ( b , i , j , k , 1 ) * q_aux_gpu ( b , i , j , k , 4 ) * sir ( 3 ) f ( 2 ) = f ( 1 ) * q_aux_gpu ( b , i , j , k , 2 ) + q_aux_gpu ( b , i , j , k , 7 ) * sir ( 1 ) f ( 3 ) = f ( 1 ) * q_aux_gpu ( b , i , j , k , 3 ) + q_aux_gpu ( b , i , j , k , 7 ) * sir ( 2 ) f ( 4 ) = f ( 1 ) * q_aux_gpu ( b , i , j , k , 4 ) + q_aux_gpu ( b , i , j , k , 7 ) * sir ( 3 ) f ( 5 ) = f ( 1 ) * q_aux_gpu ( b , i , j , k , 8 ) endsubroutine compute_conservative_fluxes_dev","tags":"","url":"proc/compute_conservative_fluxes_dev.html"},{"title":"compute_max_eigenvalues_dev – ADAM","text":"public  subroutine compute_max_eigenvalues_dev(si, sir, weno_s, b, i, j, k, ngc, nv, q_aux_gpu, evmax) Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: si (3) Stencil increment. real(kind=R8P), intent(in) :: sir (3) Stencil increment, real cast. integer(kind=I4P), intent(in) :: weno_s Weno stencils number/dimension. integer(kind=I4P), intent(in) :: b Cell indexes. integer(kind=I4P), intent(in) :: i Cell indexes. integer(kind=I4P), intent(in) :: j Cell indexes. integer(kind=I4P), intent(in) :: k Cell indexes. integer(kind=I4P), intent(in) :: ngc Ghost cells number. integer(kind=I4P), intent(in) :: nv Number of conservative varibales. real(kind=R8P), intent(in) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(inout) :: evmax (1:) Maximum eigenvalues in the big stencil. Called by proc~~compute_max_eigenvalues_dev~~CalledByGraph proc~compute_max_eigenvalues_dev compute_max_eigenvalues_dev proc~decompose_fluxes_convective_device~3 decompose_fluxes_convective_device proc~decompose_fluxes_convective_device~3->proc~compute_max_eigenvalues_dev proc~compute_fluxes_convective_ri_dev compute_fluxes_convective_ri_dev proc~compute_fluxes_convective_ri_dev->proc~decompose_fluxes_convective_device~3 proc~compute_fluxes_convective_dev compute_fluxes_convective_dev proc~compute_fluxes_convective_dev->proc~compute_fluxes_convective_ri_dev proc~compute_residuals~3 nasto_fnl_object%compute_residuals proc~compute_residuals~3->proc~compute_fluxes_convective_dev proc~integrate~3 nasto_fnl_object%integrate proc~integrate~3->proc~compute_residuals~3 proc~simulate~3 nasto_fnl_object%simulate proc~simulate~3->proc~integrate~3 program~adam_nasto_fnl adam_nasto_fnl program~adam_nasto_fnl->proc~simulate~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine compute_max_eigenvalues_dev ( si , sir , weno_s , b , i , j , k , ngc , nv , q_aux_gpu , evmax ) ! Compute maximum eigenvalues in the big stencil. integer ( I4P ), intent ( in ) :: si ( 3 ) !< Stencil increment. real ( R8P ), intent ( in ) :: sir ( 3 ) !< Stencil increment, real cast. integer ( I4P ), intent ( in ) :: weno_s !< Weno stencils number/dimension. integer ( I4P ), intent ( in ) :: b , i , j , k !< Cell indexes. integer ( I4P ), intent ( in ) :: ngc !< Ghost cells number. integer ( I4P ), intent ( in ) :: nv !< Number of conservative varibales. real ( R8P ), intent ( in ) :: q_aux_gpu ( 1 :, 1 - ngc :, 1 - ngc :, 1 - ngc :, 1 :) !< Auxiliary variables. real ( R8P ), intent ( inout ) :: evmax ( 1 :) !< Maximum eigenvalues in the big stencil. real ( R8P ) :: uu , c !< Speeds. real ( R8P ) :: ev ( 5 ) !< Signals speeds. integer ( I4P ) :: s , is , js , ks , v !< Counter. !$acc routine(compute_max_eigenvalues_dev) !$omp declare target(compute_max_eigenvalues_dev) evmax = - 1._R8P do s = 1 , 2 * weno_s is = i + ( s - weno_s ) * si ( 1 ) ; js = j + ( s - weno_s ) * si ( 2 ) ; ks = k + ( s - weno_s ) * si ( 3 ) uu = q_aux_gpu ( b , is , js , ks , 1 + 1 * si ( 1 ) + 2 * si ( 2 ) + 3 * si ( 3 )) c = q_aux_gpu ( b , is , js , ks , 9 ) ev ( 1 ) = abs ( uu - c ) ; ev ( 2 ) = abs ( uu ) ; ev ( 3 ) = abs ( uu + c ) ; ev ( 4 ) = ev ( 2 ) ; ev ( 5 ) = ev ( 2 ) do v = 1 , nv evmax ( v ) = max ( ev ( v ), evmax ( v )) enddo enddo endsubroutine compute_max_eigenvalues_dev","tags":"","url":"proc/compute_max_eigenvalues_dev.html"},{"title":"compute_eigenvectors_dev – ADAM","text":"public  subroutine compute_eigenvectors_dev(si, sir, b, i, j, k, ngc, nv, g, q_aux_gpu, el, er) Arguments Type Intent Optional Attributes Name integer(kind=I4P), intent(in) :: si (3) Stencil increment. real(kind=R8P), intent(in) :: sir (3) Stencil increment, real cast. integer(kind=I4P), intent(in) :: b Cell indexes. integer(kind=I4P), intent(in) :: i Cell indexes. integer(kind=I4P), intent(in) :: j Cell indexes. integer(kind=I4P), intent(in) :: k Cell indexes. integer(kind=I4P), intent(in) :: ngc Ghost cells number. integer(kind=I4P), intent(in) :: nv Number of conservative varibales. real(kind=R8P), intent(in) :: g Specific heats ratio. real(kind=R8P), intent(in) :: q_aux_gpu (1:,1-ngc:,1-ngc:,1-ngc:,1:) Auxiliary variables. real(kind=R8P), intent(inout) :: el (1:5,1:5) Left and right eigenvectors. real(kind=R8P), intent(inout) :: er (1:5,1:5) Left and right eigenvectors. Calls proc~~compute_eigenvectors_dev~~CallsGraph proc~compute_eigenvectors_dev compute_eigenvectors_dev proc~compute_roe_average_device~3 compute_roe_average_device proc~compute_eigenvectors_dev->proc~compute_roe_average_device~3 Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~compute_eigenvectors_dev~~CalledByGraph p