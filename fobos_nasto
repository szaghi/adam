[modes]
modes = nasto-nvf-mpi-cuda nasto-nvf-mpi-cuda-debug nasto-nvf-mpi-cuda-m100 nasto-nvf-mpi-cuda-m100-debug ascot-nvf-mpi-cuda

[common-variables]
$HDF5_cuda_22_3 = /opt/HDF5/bin/1.12.1/openmpi/3.1.5/nvidia/22.3
$HDF5_cuda_20_7 = /opt/HDF5/bin/1.12.0/openmpi/3.1.5/nvidia/20.7

# main modes
[nasto-nvf-mpi-cuda]
help     = Build nasto app with NVF-MPI-CUDA on SZ laptop
template = template-nvf-mpi-cuda-nasto
compiler = nvfortran
cflags   = -cpp -c -Mcuda=cc75,cuda11.6,ptxinfo -O2
lflags   = -Mcuda=cc75,cuda11.6,ptxinfo -O2
lib_dir  = $HDF5_cuda_22_3/lib
include  = $HDF5_cuda_22_3/include
libs     = $HDF5_cuda_22_3/lib/libhdf5hl_fortran.a
           $HDF5_cuda_22_3/lib/libhdf5_hl.a
           $HDF5_cuda_22_3/lib/libhdf5_fortran.a
           $HDF5_cuda_22_3/lib/libhdf5.a
           -Wl,-rpath,/usr/lib/gcc/x86_64-linux-gnu/10 /usr/lib/gcc/x86_64-linux-gnu/10/libstdc++.so
           /opt/zlib/bin/1.2.11/lib/libz.a
           /opt/szip/bin/2.1.1/lib/libsz.a
           ./exe/obj/cgal_c_wrappers.o
           ./exe/obj/getmemory.o

[nasto-nvf-mpi-cuda-debug]
help     = Build nasto app with NVF-MPI-CUDA on SZ laptop
template = template-nvf-mpi-cuda-nasto
compiler = nvfortran
cflags   = -cpp -c -Mcuda=cc75,cuda11.6,ptxinfo -C -gopt -Mbounds -Mchkptr -traceback
lflags   = -Mcuda=cc75,cuda11.6,ptxinfo -C -gopt -Mbounds -Mchkptr -traceback
lib_dir  = $HDF5_cuda_22_3/lib
include  = $HDF5_cuda_22_3/include
libs     = $HDF5_cuda_22_3/lib/libhdf5hl_fortran.a
           $HDF5_cuda_22_3/lib/libhdf5_hl.a
           $HDF5_cuda_22_3/lib/libhdf5_fortran.a
           $HDF5_cuda_22_3/lib/libhdf5.a
           -Wl,-rpath,/usr/lib/gcc/x86_64-linux-gnu/10 /usr/lib/gcc/x86_64-linux-gnu/10/libstdc++.so
           /opt/zlib/bin/1.2.11/lib/libz.a
           /opt/szip/bin/2.1.1/lib/libsz.a
           ./exe/obj/cgal_c_wrappers.o
           ./exe/obj/getmemory.o

[nasto-nvf-mpi-cuda-m100]
help     = Build nasto app with NVF-MPI-CUDA on marconi100 cluster
template = template-nvf-mpi-cuda-nasto
compiler = custom
fc       = mpif90
modsw    = -module=
cflags   = -cpp -c -Mcuda=cc70,cuda11.3,ptxinfo -O2
lflags   = -Mcuda=cc70,cuda11.3,ptxinfo -O2
lib_dir  = ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/lib
include  = ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/include
libs     = ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/lib/libhdf5hl_fortran.a
           ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/lib/libhdf5_hl.a
           ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/lib/libhdf5_fortran.a
           ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/lib/libhdf5.a
           -Wl,-rpath,/cineca/prod/opt/compilers/gnu/8.4.0/none/lib64 /cineca/prod/opt/compilers/gnu/8.4.0/none/lib64/libstdc++.so.6.0.25
           /cineca/prod/opt/libraries/zlib/1.2.11/gnu--8.4.0/lib/libz.a
           /cineca/prod/opt/libraries/szip/2.1.1/gnu--8.4.0/lib/libsz.a
           ./exe/obj/cgal_c_wrappers.o
           ./exe/obj/getmemory.o

[nasto-nvf-mpi-cuda-m100-debug]
help     = Build nasto app with NVF-MPI-CUDA on marconi100 cluster
template = template-nvf-mpi-cuda-nasto
compiler = custom
fc       = mpif90
modsw    = -module=
cflags   = -cpp -c -Mcuda=cc70,cuda11.3,ptxinfo -C -gopt -Mbounds -Mchkptr -traceback
lflags   = -Mcuda=cc70,cuda11.3,ptxinfo -C -gopt -Mbounds -Mchkptr -traceback
lib_dir  = ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/lib
include  = ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/include
libs     = ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/lib/libhdf5hl_fortran.a
           ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/lib/libhdf5_hl.a
           ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/lib/libhdf5_fortran.a
           ./lib/HDF5_NVFORTRAN/install_hdf5-1.12.0/lib/libhdf5.a
           -Wl,-rpath,/cineca/prod/opt/compilers/gnu/8.4.0/none/lib64 /cineca/prod/opt/compilers/gnu/8.4.0/none/lib64/libstdc++.so.6.0.25
           /cineca/prod/opt/libraries/zlib/1.2.11/gnu--8.4.0/lib/libz.a
           /cineca/prod/opt/libraries/szip/2.1.1/gnu--8.4.0/lib/libsz.a
           ./exe/obj/cgal_c_wrappers.o
           ./exe/obj/getmemory.o

[ascot-nvf-mpi-cuda]
compiler     = nvfortran
cflags       = -cpp -c -Mcuda=cc75,cuda11.6,ptxinfo -O2
lflags       = -Mcuda=cc75,cuda11.6,ptxinfo -O2
preproc      = -D_NVF
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
build_dir    = ./exe/
target       = ascot.F90
colors       = True
quiet        = False
log          = True
jobs         = 4
exclude_dirs = references/
               BeFoR64/src/tests/
               BeFoR64/src/third_party/
               FACE/src/tests/
               FACE/src/third_party/
               FiNeR/src/tests/
               FiNeR/src/third_party/
               FOSSIL/src/app/
               FOSSIL/src/tests/
               FOSSIL/src/third_party/
               FoXy/src/tests/
               FoXy/src/third_party/
               MORTIF/src/tests/
               MORTIF/src/third_party/
               PENF/src/tests/
               StringiFor/src/tests/
               StringiFor/src/third_party/
               VecFor/src/tests/
               VecFor/src/third_party/
               VTKFortran/src/tests/
               VTKFortran/src/third_party/
               third_party_manual/

# templates
[template-nvf-mpi-cuda-nasto]
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
build_dir    = ./exe/
target       = adam_nasto_gpu.F90
colors       = True
quiet        = False
log          = True
jobs         = 4
mpi          = True
preproc      = -D_NVF -D_MPI_
ext_libs     = dl m
exclude_dirs = references/
               BeFoR64/src/tests/
               BeFoR64/src/third_party/
               FACE/src/tests/
               FACE/src/third_party/
               FiNeR/src/tests/
               FiNeR/src/third_party/
               FOSSIL/src/app/
               FOSSIL/src/tests/
               FOSSIL/src/third_party/
               FoXy/src/tests/
               FoXy/src/third_party/
               MORTIF/src/tests/
               MORTIF/src/third_party/
               PENF/src/tests/
               StringiFor/src/tests/
               StringiFor/src/third_party/
               VecFor/src/tests/
               VecFor/src/third_party/
               VTKFortran/src/tests/
               VTKFortran/src/third_party/
               third_party_manual/

# aux rules
[rule-makethirdpartymanual]
help   = Make third party manual-compiling libraries on SZ laptop
rule_1 = mkdir -p exe/mod exe/obj
rule_2 = cd src/third_party_manual/CGAL/ ; g++ -std=c++17 -frounding-math -O2 -I/opt/cgal/5.2.1/include/ -c cgal_c_wrappers.cpp ; cd -
rule_3 = cd src/third_party_manual/getmemory/ ; gcc -c getmemory.c ; cd -
rule_4 = mv src/third_party_manual/getmemory/*.o exe/obj/
rule_5 = mv src/third_party_manual/CGAL/*.o exe/obj/

[rule-makethirdpartymanual-m100]
help   = Make third party manual-compiling libraries on marconi100 cluster
rule_1 = mkdir -p exe/mod exe/obj
rule_2 = cd src/third_party_manual/CGAL/ ; g++ -std=c++17 -frounding-math -O2 -I/cineca/prod/opt/libraries/boost/1.76.0/spectrum_mpi--10.4.0--binary/include -I../../../lib/CGAL-5.0.2-INSTALL/include/ -I /cineca/prod/opt/libraries/mpfr/4.0.2/gnu--8.4.0/include -c cgal_c_wrappers.cpp ; cd -
rule_3 = cd src/third_party_manual/getmemory/ ; gcc -c getmemory.c ; cd -
rule_4 = mv src/third_party_manual/getmemory/*.o exe/obj/
rule_5 = mv src/third_party_manual/CGAL/*.o exe/obj/
