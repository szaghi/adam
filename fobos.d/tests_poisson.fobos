[modes]
modes = test-poisson-fft-gnu                           test-poisson-fft-gnu-debug
        test-poisson-fft-fnl-nvf
        test-poisson-mg-gnu                            test-poisson-mg-gnu-debug
        test-poisson-mg-fnl-nvf
        test-flail-bc-gnu                              test-flail-bc-fnl-nvf
        bench-poisson-gnu                              bench-poisson-fnl-nvf

# The FFT Poisson solver (issue #81): -D_FFTW links FFTW 3 on the CPU, -D_CUFFT cuFFT on FNL. The modes have their own
# mod/obj directories: the solver module is compiled with different macros than in the default builds.
[test-poisson-fft-gnu]
template = template-gnu
mod_dir  = ./mod/gnu-fft/
obj_dir  = ./obj/gnu-fft/
preproc  = -D_MPI_ -D_FFTW -w
ext_libs = z hdf5_fortran dl fftw3
target   = test_poisson_fft.F90

[test-poisson-fft-gnu-debug]
template = template-gnu-debug
mod_dir  = ./mod/gnu-fft/debug/
obj_dir  = ./obj/gnu-fft/debug/
preproc  = -D_MPI_ -D_FFTW -w
ext_libs = z hdf5_fortran dl fftw3
target   = test_poisson_fft.F90

[test-poisson-fft-fnl-nvf]
template = template-nvf
mod_dir  = ./mod/nvf-fft/
obj_dir  = ./obj/nvf-fft/
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -D_CUFFT -w
lflags   = -acc -gpu=$NVF_CC$NVF_LTO -fast -Minfo=all -cudalib=cufft
target   = test_poisson_fft.F90
output   = test_poisson_fft_fnl

# The multigrid-preconditioned CG solver on AMR grids (issue #81, P5a): its coarsest level is the FFT solver, so the
# modes link FFTW and share the FFT modes' mod/obj directories.
[test-poisson-mg-gnu]
template = template-gnu
mod_dir  = ./mod/gnu-fft/
obj_dir  = ./obj/gnu-fft/
preproc  = -D_MPI_ -D_FFTW -w
ext_libs = z hdf5_fortran dl fftw3
target   = test_poisson_mg.F90

[test-poisson-mg-gnu-debug]
template = template-gnu-debug
mod_dir  = ./mod/gnu-fft/debug/
obj_dir  = ./obj/gnu-fft/debug/
preproc  = -D_MPI_ -D_FFTW -w
ext_libs = z hdf5_fortran dl fftw3
target   = test_poisson_mg.F90

# The multigrid on the device (issue #84, E6a): the FCG iteration and the V-cycle on the GPU, the coarsest level on
# cuFFT; the facade legs take the same backend.
[test-poisson-mg-fnl-nvf]
template = template-nvf
mod_dir  = ./mod/nvf-fft/
obj_dir  = ./obj/nvf-fft/
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -D_CUFFT -w
lflags   = -acc -gpu=$NVF_CC$NVF_LTO -fast -Minfo=all -cudalib=cufft
target   = test_poisson_mg.F90
output   = test_poisson_mg_fnl

# FLAIL boundary conditions per face (issue #84, E1a): the FFT solver's extensions, on initialize_blocks/solve_blocks.
[test-flail-bc-gnu]
template = template-gnu
mod_dir  = ./mod/gnu-fft/
obj_dir  = ./obj/gnu-fft/
preproc  = -D_MPI_ -D_FFTW -w
ext_libs = z hdf5_fortran dl fftw3
target   = test_flail_bc.F90

[test-flail-bc-fnl-nvf]
template = template-nvf
mod_dir  = ./mod/nvf-fft/
obj_dir  = ./obj/nvf-fft/
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -D_CUFFT -w
lflags   = -acc -gpu=$NVF_CC$NVF_LTO -fast -Minfo=all -cudalib=cufft
target   = test_flail_bc.F90
output   = test_flail_bc_fnl

# Scaling benchmark of FLAIL's solves (issue #84, E5): the FFT path, the multigrid with its coarsest level and James
# step, phase by phase; src/tests/poisson/bench.sh runs the ladders.
[bench-poisson-gnu]
template = template-gnu
mod_dir  = ./mod/gnu-fft/
obj_dir  = ./obj/gnu-fft/
preproc  = -D_MPI_ -D_FFTW -w
ext_libs = z hdf5_fortran dl fftw3
target   = bench_poisson.F90

[bench-poisson-fnl-nvf]
template = template-nvf
mod_dir  = ./mod/nvf-fft/
obj_dir  = ./obj/nvf-fft/
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -D_CUFFT -w
lflags   = -acc -gpu=$NVF_CC$NVF_LTO -fast -Minfo=all -cudalib=cufft
target   = bench_poisson.F90
output   = bench_poisson_fnl
