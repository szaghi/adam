[modes]
modes = test-rk-ssp-tableau-gnu                        test-rk-ssp-tableau-gnu-debug
        test-selah-stepper-smoke-gnu                   test-selah-stepper-smoke-fnl-nvf
        test-stepper-object-gnu                        test-stepper-object-xfail-gnu

# The SSP Runge-Kutta Butcher tableaux (issue #104): order conditions in quadruple precision, constant forcing exact,
# the convergence order on y' = -y. Pure, no MPI calls.
[test-rk-ssp-tableau-gnu]
template = template-gnu
preproc  = -D_MPI_ -w
target   = test_rk_ssp_tableau.F90

[test-rk-ssp-tableau-gnu-debug]
template = template-gnu-debug
preproc  = -D_MPI_ -w
target   = test_rk_ssp_tableau.F90

# SELAH, the time integrators (SELAH M7, ADAM #132 0.3): a SELAH stepper takes one SSP-33 step on an ADAM-shaped field,
# Butcher and two-register forms. The host build (the CPU modes' flags) and the OpenACC build (the FNL modes' macros,
# -DDEV_OAC -DCOMPILER_NVF: the field and SELAH's registers in device memory, the residual a device loop).
[test-selah-stepper-smoke-gnu]
template = template-gnu
preproc  = -D_MPI_ -w
target   = test_selah_stepper_smoke.F90

[test-selah-stepper-smoke-fnl-nvf]
template = template-nvf
mod_dir  = ./mod/nvf/selah-smoke/
obj_dir  = ./obj/nvf/selah-smoke/
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = test_selah_stepper_smoke.F90
output   = test_selah_stepper_smoke_fnl

# The SELAH adapter stepper_object (SELAH M7, ADAM #132 box 1.2): the scheme mapping, the stored fields, one step of
# y' = -y per scheme on an ADAM-shaped field, unmasked and masked, the stage weights and times, the scratch registers.
# The xfail program stops on an unknown scheme (exit 1); with a known scheme as argument it exits 0. No MPI run.
[test-stepper-object-gnu]
template = template-gnu
preproc  = -D_MPI_ -w
target   = test_stepper_object.F90

[test-stepper-object-xfail-gnu]
template = template-gnu
preproc  = -D_MPI_ -w
target   = test_stepper_object_xfail.F90
