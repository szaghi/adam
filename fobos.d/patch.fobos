[modes]
modes = patch-cpu-gnu patch-cpu-gnu-debug patch-fnl-nvf patch-fnl-nvf-debug patch-fnl-omp-amd patch-fnl-omp-amd-debug

[patch-cpu-gnu]
template = template-gnu
preproc  = -D_MPI_ -w
target   = adam_patch_cpu.F90

[patch-cpu-gnu-debug]
template = template-gnu-debug
preproc  = -D_MPI_ -w
target   = adam_patch_cpu.F90

[patch-fnl-nvf]
template = template-nvf
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = adam_patch_fnl.F90

[patch-fnl-nvf-debug]
template = template-nvf-debug
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = adam_patch_fnl.F90

[patch-fnl-omp-amd]
template = template-omp-amd
preproc  = -D_FNL -D_MPI_ -DDEV_OMP -DDEV_HIP -w
target   = adam_patch_fnl.F90

[patch-fnl-omp-amd-debug]
template = template-omp-amd-debug
preproc  = -D_FNL -D_MPI_ -DDEV_OMP -DDEV_HIP -w
target   = adam_patch_fnl.F90
