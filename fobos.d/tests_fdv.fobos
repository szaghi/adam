target   = test_fdv_laplacian_trigonometric.F90

[test-fdv-operators-step-gnu]
template = template-gnu
preproc  = -D_MPI_ -w
target   = test_fdv_operators_step.F90

[test-fdv-operators-step-gnu-debug]
template = template-gnu-debug
preproc  = -D_MPI_ -w
target   = test_fdv_operators_step.F90

