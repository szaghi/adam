[modes]
modes = test-fdv-curl-trigonometric-gnu               test-fdv-curl-trigonometric-gnu-debug
        test-fdv-fnl-curl-trigonometric-nvf
        test-fdv-fnl-operators-trigonometric-nvf
        test-fdv-fnl-operators-vector-trigonometric-nvf
        test-fdv-fnl-curl-trigonometric-omp-amd
        test-fdv-fnl-operators-trigonometric-omp-amd
        test-fdv-fnl-operators-vector-trigonometric-omp-amd
        test-fdv-divergence-trigonometric-gnu         test-fdv-divergence-trigonometric-gnu-debug
        test-fdv-gradient-trigonometric-gnu           test-fdv-gradient-trigonometric-gnu-debug
        test-fdv-laplacian-trigonometric-gnu          test-fdv-laplacian-trigonometric-gnu-debug
        test-fdv-operators-step-gnu                   test-fdv-operators-step-gnu-debug
        test-fdv-operators-trigonometric-gnu          test-fdv-operators-trigonometric-gnu-debug
        test-prism-reflux-apply-gnu                   test-prism-reflux-apply-gnu-debug
        test-prism-induction-flux-share-gnu           test-prism-induction-flux-share-gnu-debug

[test-fdv-curl-trigonometric-gnu]
template = template-gnu
preproc  = -D_MPI_ -w
target   = test_fdv_curl_trigonometric.F90

[test-fdv-fnl-curl-trigonometric-nvf]
template = template-nvf
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = test_fdv_fnl_curl_trigonometric.F90

[test-fdv-fnl-operators-trigonometric-nvf]
template = template-nvf
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = test_fdv_fnl_operators_trigonometric.F90

[test-fdv-fnl-operators-vector-trigonometric-nvf]
template = template-nvf
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = test_fdv_fnl_operators_vector_trigonometric.F90

[test-fdv-fnl-curl-trigonometric-omp-amd]
template = template-omp-amd
preproc  = -D_FNL -D_MPI_ -DDEV_OMP -DDEV_HIP -w
target   = test_fdv_fnl_curl_trigonometric.F90

[test-fdv-fnl-operators-trigonometric-omp-amd]
template = template-omp-amd
preproc  = -D_FNL -D_MPI_ -DDEV_OMP -DDEV_HIP -w
target   = test_fdv_fnl_operators_trigonometric.F90

[test-fdv-fnl-operators-vector-trigonometric-omp-amd]
template = template-omp-amd
preproc  = -D_FNL -D_MPI_ -DDEV_OMP -DDEV_HIP -w
target   = test_fdv_fnl_operators_vector_trigonometric.F90

[test-fdv-curl-trigonometric-gnu-debug]
template = template-gnu-debug
preproc  = -D_MPI_ -w
target   = test_fdv_curl_trigonometric.F90

[test-fdv-divergence-trigonometric-gnu]
