[template-base]
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
build_dir    = ./exe/
colors       = True
quiet        = False
log          = True
jobs         = 4
mpi          = True
ext_libs     = z hdf5_fortran
libs         = $HDF5_PREFIX/lib/libhdf5_fortran.a $HDF5_PREFIX/lib/libhdf5_f90cstub.a $HDF5_PREFIX/lib/libhdf5.a
lib_dir      = $HDF5_PREFIX/lib
include      = $HDF5_PREFIX/include
exclude_dirs = references/
               .venv/
               BeFoR64/src/tests/
               BeFoR64/src/third_party/
               FACE/src/tests/
               FACE/src/third_party/
               FiNeR/src/tests/
               FiNeR/src/third_party/
               FOSSIL/src/app/
               FOSSIL/src/tests/
               FOSSIL/src/third_party/
               FoXy/src/tests/
               FoXy/src/third_party/
               FUNDAL/src/examples/
               FUNDAL/src/tests/
               FUNDAL/src/third_party/
               FUNDAL/compilers_proofs/
               MORTIF/src/tests/
               MORTIF/src/third_party/
               MOTIOn/src/tests/
               MOTIOn/src/third_party/
               MOTIOn/lib
               PENF/src/tests/
               StringiFor/src/tests/
               StringiFor/src/third_party/
               VecFor/src/tests/
               VecFor/src/third_party/
               VTKFortran/src/tests/
               VTKFortran/src/third_party/

[template-gnu]
template = template-base
mod_dir  = ./mod/gnu/
obj_dir  = ./obj/gnu/
compiler = gnu
cflags   = -cpp -c -O2
lflags   = -O2

[template-gnu-debug]
template = template-gnu
mod_dir  = ./mod/gnu/debug/
obj_dir  = ./obj/gnu/debug/
cflags   = -cpp -c -pg -O0 -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -fmodule-private -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan -fcheck=all -finit-real=snan -finit-integer=-2147483647 -finit-derived -ffpe-trap=invalid,zero,overflow
lflags   =         -pg -O0 -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -fmodule-private -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan -fcheck=all -finit-real=snan -finit-integer=-2147483647 -finit-derived -ffpe-trap=invalid,zero,overflow

[template-nvf]
template = template-base
mod_dir  = ./mod/nvf/
obj_dir  = ./obj/nvf/
compiler = nvfortran
cflags   = -cpp -c -acc -gpu=$NVF_CC -fast -Minfo=all
lflags   =         -acc -gpu=$NVF_CC -fast -Minfo=all

[template-nvf-debug]
template = template-nvf
mod_dir  = ./mod/nvf/debug/
obj_dir  = ./obj/nvf/debug/
cflags   = -cpp -c -acc -gpu=$NVF_CC -Minfo=all -C -gopt -Mbounds -traceback -Mchkptr -Mchkstk -Ktrap=fp -g -O0
lflags   =         -acc -gpu=$NVF_CC -Minfo=all -C -gopt -Mbounds -traceback -Mchkptr -Mchkstk -Ktrap=fp -g -O0
