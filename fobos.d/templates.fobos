[template-base]
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
build_dir    = ./exe/
colors       = True
quiet        = False
log          = True
jobs         = 4
mpi          = True
# `cudafor` (and its CUDA-runtime siblings) ship as intrinsic modules with
# nvfortran only.  FoBiS parses the whole `src/` tree for every mode, so the
# CUDA Fortran backend (src/lib/nvf/, src/app/*/nvf/) is scanned even by GNU
# and AMD modes that never compile it -- emitting "depends on 'cudafor' that
# is unreachable" noise whose only "fix" would be to switch compiler.  Declare
# them intrinsic project-wide so the dependency scanner skips the `use` lines
# regardless of the active compiler.  Matching is case-insensitive, so this
# also covers the `use CUDAFOR` spelling in adam_{field,ib}_nvf_kernels.F90. `cufft` and `openacc` (nvfortran
# intrinsic modules too) serve the FNL FFT Poisson solver (issue #81).
intrinsic_modules = cudafor cudadeviceprop cufft openacc
ext_libs     = z hdf5_fortran dl
libs         = $HDF5_PREFIX/lib/libhdf5_fortran.a $HDF5_PREFIX/lib/libhdf5_f90cstub.a $HDF5_PREFIX/lib/libhdf5.a
lib_dir      = $HDF5_PREFIX/lib
include      = $HDF5_PREFIX/include
exclude_dirs = references/
               BeFoR64/src/tests/
               BeFoR64/src/third_party/
               FACE/src/tests/
               FACE/src/third_party/
               FiNeR/src/tests/
               FiNeR/src/third_party/
               FOSSIL/src/app/
               FOSSIL/src/tests/
               FOSSIL/src/third_party/
               FoXy/src/tests/
               FoXy/src/third_party/
               FUNDAL/src/examples/
               FUNDAL/src/tests/
               FUNDAL/src/third_party/
               FUNDAL/compilers_proofs/
               MORTIF/src/tests/
               MORTIF/src/third_party/
               MOTIOn/src/tests/
               MOTIOn/src/third_party/
               MOTIOn/lib
               PENF/src/tests/
               StringiFor/src/tests/
               StringiFor/src/third_party/
               VecFor/src/tests/
               VecFor/src/third_party/
               VTKFortran/src/tests/
               VTKFortran/src/third_party/

[template-gnu]
template = template-base
mod_dir  = ./mod/gnu/
obj_dir  = ./obj/gnu/
compiler = gnu
cflags   = -cpp -c -O2
lflags   = -O2

[template-gnu-cov]
template = template-gnu
mod_dir  = ./mod/gnu-cov/
obj_dir  = ./obj/gnu-cov/
coverage = True

[template-gnu-debug]
template = template-gnu
mod_dir  = ./mod/gnu/debug/
obj_dir  = ./obj/gnu/debug/
cflags   = -cpp -c -pg -O0 -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -fmodule-private -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan -fcheck=all -finit-real=snan -finit-integer=-2147483647 -finit-derived -ffpe-trap=invalid,zero,overflow
lflags   =         -pg -O0 -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -fmodule-private -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan -fcheck=all -finit-real=snan -finit-integer=-2147483647 -finit-derived -ffpe-trap=invalid,zero,overflow

[template-nvf]
template = template-base
mod_dir  = ./mod/nvf/
obj_dir  = ./obj/nvf/
compiler = nvfortran
# $NVF_LTO (fobos [common-variables]): device link-time optimisation where the varset enables it; the modes that
# override lflags (the cuFFT links) repeat it, the debug modes leave it out. cflags_heritage: a change of the flags
# (switching $NVF_LTO) recompiles every file, so LTO never links objects compiled without it
cflags_heritage = True
cflags   = -cpp -c -acc -gpu=$NVF_CC$NVF_LTO -fast -Minfo=all
lflags   =         -acc -gpu=$NVF_CC$NVF_LTO -fast -Minfo=all

[template-nvf-debug]
template = template-nvf
mod_dir  = ./mod/nvf/debug/
obj_dir  = ./obj/nvf/debug/
cflags   = -cpp -c -acc -gpu=$NVF_CC -Minfo=all -C -gopt -Mbounds -traceback -Mchkptr -Mchkstk -Ktrap=fp -g -O0
lflags   =         -acc -gpu=$NVF_CC -Minfo=all -C -gopt -Mbounds -traceback -Mchkptr -Mchkstk -Ktrap=fp -g -O0

# OpenMP target offload, Intel GPUs (ifx / oneAPI).
#
# Same DEV_OMP source path as the AMD modes, but WITHOUT -DDEV_HIP: the HIP
# runtime queries FUNDAL uses for device memory and properties do not exist on
# the Intel stack, and fundal_dev_handling.F90 guards them on DEV_HIP precisely
# for this case (they return zeros instead). ifx is required, not ifort: the
# classic compiler has no OpenMP GPU offload.
#
# UNTESTED on this cluster -- no Intel compiler and no Intel GPU here. The flags
# follow the oneAPI documented form; expect to adjust -fopenmp-targets for a
# specific device (e.g. spir64_gen with -Xs "-device pvc" for AOT).
[template-omp-intel]
template = template-base
mod_dir  = ./mod/intel/omp/
obj_dir  = ./obj/intel/omp/
compiler = intel
cflags   = -cpp -c -O2 -fiopenmp -fopenmp-targets=spir64
lflags   =         -O2 -fiopenmp -fopenmp-targets=spir64 -Wl,-rpath,$HDF5_PREFIX/lib

[template-omp-intel-debug]
template = template-omp-intel
mod_dir  = ./mod/intel/omp/debug/
obj_dir  = ./obj/intel/omp/debug/
cflags   = -cpp -c -g -O0 -check all -traceback -fiopenmp -fopenmp-targets=spir64
lflags   =         -g -O0 -check all -traceback -fiopenmp -fopenmp-targets=spir64 -Wl,-rpath,$HDF5_PREFIX/lib

# CUDA Fortran (`!$cuf kernel do(N)` + `device` attribute arrays), NVIDIA GPUs.
#
# A `template-nvf-cuda` already exists, but it lives inside fobos.d/ascot.fobos,
# which the root fobos includes OPTIONALLY (`?fobos.d/ascot.fobos`) -- so any mode
# outside ascot that referenced it would fail to resolve whenever that file is
# absent. It also hardcodes `-gpu=cc89`. This one lives in the unconditionally
# included templates file and takes the compute capability from $NVF_CC, like
# template-nvf does.
[template-nvf-cuf]
template = template-base
mod_dir  = ./mod/nvf/cuf/
obj_dir  = ./obj/nvf/cuf/
compiler = nvfortran
cflags   = -cpp -c -cuda -gpu=$NVF_CC -fast -Minfo=all
lflags   =         -cuda -gpu=$NVF_CC -fast -Minfo=all

[template-nvf-cuf-debug]
template = template-nvf-cuf
mod_dir  = ./mod/nvf/cuf/debug/
obj_dir  = ./obj/nvf/cuf/debug/
cflags   = -cpp -c -cuda -gpu=$NVF_CC -Minfo=all -C -gopt -Mbounds -traceback -g -O0
lflags   =         -cuda -gpu=$NVF_CC -Minfo=all -C -gopt -Mbounds -traceback -g -O0

[template-amd]
template = template-base
mod_dir  = ./mod/amd/
obj_dir  = ./obj/amd/
compiler = amd
cflags   = -cpp -c -O2 -fopenmp
lflags   =         -O2 -fopenmp -Wl,-rpath,$HDF5_PREFIX/lib -Wl,-z,execstack

[template-amd-debug]
template = template-base
mod_dir  = ./mod/amd/
obj_dir  = ./obj/amd/
compiler = amd
cflags   = -cpp -c -g -O0 -fopenmp
lflags   =         -g -O0 -fopenmp -Wl,-rpath,$HDF5_PREFIX/lib -Wl,-z,execstack

[template-omp-amd]
template = template-amd
mod_dir  = ./mod/amd/omp/
obj_dir  = ./obj/amd/omp/
cflags   = -cpp -c -O2 -fopenmp --offload-arch=$GPU_ARCH
lflags   =         -O2 -fopenmp --offload-arch=$GPU_ARCH -lamdhip64 -Wl,-rpath,$HDF5_PREFIX/lib -Wl,-z,execstack

[template-omp-amd-debug]
template = template-amd
mod_dir  = ./mod/amd/omp/
obj_dir  = ./obj/amd/omp/
cflags   = -cpp -c -g -O0 -fopenmp --offload-arch=$GPU_ARCH
lflags   =         -g -O0 -fopenmp --offload-arch=$GPU_ARCH -lamdhip64 -Wl,-rpath,$HDF5_PREFIX/lib -Wl,-z,execstack
