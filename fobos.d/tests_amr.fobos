[modes]
modes = test-amr-geo-box-gnu                          test-amr-geo-box-gnu-debug
        test-amr-reflux-restrict-gnu                   test-amr-reflux-restrict-gnu-debug
        test-seam-interpolation-gnu                    test-seam-interpolation-gnu-debug
        test-seam-interpolation-fnl-nvf
        test-seam-interpolation-fnl-omp-amd

[test-amr-geo-box-gnu]
template = template-gnu
preproc  = -D_MPI_ -w
target   = test_amr_geo_box.F90

[test-amr-geo-box-gnu-debug]
template = template-gnu-debug
preproc  = -D_MPI_ -w
target   = test_amr_geo_box.F90

[test-amr-reflux-restrict-gnu]
template = template-gnu
preproc  = -D_MPI_ -w
target   = test_amr_reflux_restrict.F90

[test-amr-reflux-restrict-gnu-debug]
template = template-gnu-debug
preproc  = -D_MPI_ -w
target   = test_amr_reflux_restrict.F90

[test-seam-interpolation-gnu]
template = template-gnu
preproc  = -D_MPI_ -w
target   = test_seam_interpolation.F90

[test-seam-interpolation-gnu-debug]
template = template-gnu-debug
preproc  = -D_MPI_ -w
target   = test_seam_interpolation.F90

[test-seam-interpolation-fnl-nvf]
template = template-nvf
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = test_seam_interpolation_fnl.F90

[test-seam-interpolation-fnl-omp-amd]
template = template-omp-amd
preproc  = -D_FNL -D_MPI_ -DDEV_OMP -DDEV_HIP -w
target   = test_seam_interpolation_fnl.F90
