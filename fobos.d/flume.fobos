[modes]
modes = flume-cpu-gnu flume-cpu-gnu-omp flume-cpu-gnu-debug flume-cpu-gnu-fft flume-cpu-gnu-fft-debug flume-fnl-nvf flume-fnl-nvf-debug flume-fnl-nvf-fft flume-fnl-nvf-fft-debug flume-fnl-omp-amd flume-fnl-omp-amd-debug test-flume-euler-library-gnu test-flume-euler-library-fnl-nvf test-flume-euler-library-fnl-omp-amd test-flume-mhd-library-gnu test-flume-mhd-library-fnl-nvf test-flume-mhd-library-fnl-omp-amd test-flume-mhd-riemann-gnu test-flume-mhd-riemann-fnl-nvf test-flume-mhd-riemann-fnl-omp-amd test-flume-positivity-gnu test-flume-weno-interpolation-gnu test-flume-weno-weights-gnu test-flume-weno-interpolation-fnl-nvf test-flume-weno-interpolation-fnl-omp-amd test-flume-user-criterion-cpu-gnu

# Every application mode has its own mod_dir/obj_dir, ./mod/flume/<toolchain>/ (issue #72): PRISM and FLUME compile the
# same library sources, and with one directory per compiler an incremental build of one app left the other's modules
# stale. The test-* modes below keep the shared template directories.
[flume-cpu-gnu]
template = template-gnu
mod_dir  = ./mod/flume/gnu/
obj_dir  = ./obj/flume/gnu/
preproc  = -D_MPI_ -w
target   = adam_flume_cpu.F90

[test-flume-user-criterion-cpu-gnu]
; issue #110 P4: the FLUME CPU driver plus a registered refinement criterion (multirealm/check.sh leg 10); FLUME's objects
template = template-gnu
mod_dir  = ./mod/flume/gnu/
obj_dir  = ./obj/flume/gnu/
preproc  = -D_MPI_ -w
target   = test_flume_user_criterion.F90
output   = test_flume_user_criterion

[flume-cpu-gnu-omp]
template = template-gnu
mod_dir  = ./mod/flume/gnu-omp/
obj_dir  = ./obj/flume/gnu-omp/
openmp   = True
preproc  = -D_MPI_ -w
target   = adam_flume_cpu.F90
output   = adam_flume_cpu_omp

[flume-cpu-gnu-debug]
template = template-gnu-debug
mod_dir  = ./mod/flume/gnu/debug/
obj_dir  = ./obj/flume/gnu/debug/
preproc  = -D_MPI_ -w
target   = adam_flume_cpu.F90

# self-gravity (issue #81): the FFT Poisson solver, FFTW on the CPU (-D_FFTW), cuFFT on FNL (-D_CUFFT); own mod/obj
# directories (the solver modules compile with other macros than in the default builds) and own executables
[flume-cpu-gnu-fft]
template = template-gnu
mod_dir  = ./mod/flume/gnu-fft/
obj_dir  = ./obj/flume/gnu-fft/
preproc  = -D_MPI_ -D_FFTW -w
ext_libs = z hdf5_fortran dl fftw3
target   = adam_flume_cpu.F90
output   = adam_flume_cpu_fft

[flume-cpu-gnu-fft-debug]
template = template-gnu-debug
mod_dir  = ./mod/flume/gnu-fft/debug/
obj_dir  = ./obj/flume/gnu-fft/debug/
preproc  = -D_MPI_ -D_FFTW -w
ext_libs = z hdf5_fortran dl fftw3
target   = adam_flume_cpu.F90
output   = adam_flume_cpu_fft

[flume-fnl-nvf-fft]
template = template-nvf
mod_dir  = ./mod/flume/nvf-fft/
obj_dir  = ./obj/flume/nvf-fft/
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -D_CUFFT -w
lflags   = -acc -gpu=$NVF_CC$NVF_LTO -fast -Minfo=all -cudalib=cufft
target   = adam_flume_fnl.F90
output   = adam_flume_fnl_fft

[flume-fnl-nvf-fft-debug]
template = template-nvf-debug
mod_dir  = ./mod/flume/nvf-fft/debug/
obj_dir  = ./obj/flume/nvf-fft/debug/
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -D_CUFFT -w
lflags   = -acc -gpu=$NVF_CC -Minfo=all -C -gopt -Mbounds -traceback -Mchkptr -Mchkstk -Ktrap=fp -g -O0 -cudalib=cufft
target   = adam_flume_fnl.F90
output   = adam_flume_fnl_fft

[flume-fnl-nvf]
template = template-nvf
mod_dir  = ./mod/flume/nvf/
obj_dir  = ./obj/flume/nvf/
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = adam_flume_fnl.F90

[flume-fnl-nvf-debug]
template = template-nvf-debug
mod_dir  = ./mod/flume/nvf/debug/
obj_dir  = ./obj/flume/nvf/debug/
preproc  = -D_FNL -D_MPI_ -DDEV_OAC -DCOMPILER_NVF -w
target   = adam_flume_fnl.F90

[flume-fnl-omp-amd]
template = template-omp-amd
mod_dir  = ./mod/flume/amd/omp/
obj_dir  = ./obj/flume/amd/omp/
preproc  = -D_FNL -D_MPI_ -DDEV_OMP -DDEV_HIP -w
target   = adam_flume_fnl.F90

[flume-fnl-omp-amd-debug]
template = template-omp-amd-debug
mod_dir  = ./mod/flume/amd/omp/debug/
obj_dir  = ./obj/flume/amd/omp/debug/
preproc  = -D_FNL -D_MPI_ -DDEV_OMP -DDEV_HIP -w
target   = adam_flume_fnl.F90

[test-flume-euler-library-gnu]
template = template-gnu
preproc  = -w
target   = test_flume_euler_library.F90

[test-flume-euler-library-fnl-nvf]
template = template-nvf
preproc  = -DDEV_OAC -DCOMPILER_NVF -w
target   = test_flume_euler_library_fnl.F90

[test-flume-euler-library-fnl-omp-amd]
template = template-omp-amd
preproc  = -DDEV_OMP -DDEV_HIP -w
target   = test_flume_euler_library_fnl.F90

[test-flume-mhd-library-gnu]
