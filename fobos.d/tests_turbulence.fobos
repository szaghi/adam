[modes]
modes = test-sgs-gnu test-kep-gnu test-wm-gnu test-df-gnu

# The pointwise subgrid-scale formulas of the library against an independent computation (issue #119, T1): verification/turbulence
# leg sg1. No MPI, no HDF5: the program reads the tensors on stdin.
[test-sgs-gnu]
template = template-gnu
mod_dir  = ./mod/gnu-sgs/
obj_dir  = ./obj/gnu-sgs/
target   = test_sgs.F90

# The central flux of the hybrid scheme (issue #119, T2): verification/turbulence leg hy3.
[test-kep-gnu]
template = template-gnu
mod_dir  = ./mod/gnu-kep/
obj_dir  = ./obj/gnu-kep/
target   = test_kep.F90

# The wall models (issue #119, T3.4, T3.5), leg wm2: laminar limit, log law against a fine quadrature, Crocco; the inverse model against Eq. 2.2.
[test-wm-gnu]
template = template-gnu
mod_dir  = ./mod/gnu-wm/
obj_dir  = ./obj/gnu-wm/
target   = test_wall_model.F90

# The digital-filter inflow generator (issue #119, T3.7), leg df1: stresses, temporal and spanwise correlations, periodic span, bitwise restart.
[test-df-gnu]
template = template-gnu
mod_dir  = ./mod/gnu-df/
obj_dir  = ./obj/gnu-df/
target   = test_inflow_df.F90
