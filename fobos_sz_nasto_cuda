[modes]
modes = nasto-nvf-mpi-cuda

[common-variables]
$CSTATIC_NVF = -cpp -c
$CSTATIC_CUDA_NVF = -cpp -c -Mcuda=cc75,cuda11.0,ptxinfo
$LSTATIC_CUDA_NVF = -Mcuda=cc75,cuda11.0,ptxinfo
$DEBUG_NVF   = -O0 -g -C
$OPTIMIZE    = -O3
$EXDIRS      = references/
               BeFoR64/src/tests/
               BeFoR64/src/third_party/
               FACE/src/tests/
               FACE/src/third_party/
               FiNeR/src/tests/
               FiNeR/src/third_party/
               FOSSIL/src/app/
               FOSSIL/src/tests/
               FOSSIL/src/third_party/
               FoXy/src/tests/
               FoXy/src/third_party/
               MORTIF/src/tests/
               MORTIF/src/third_party/
               PENF/src/tests/
               StringiFor/src/tests/
               StringiFor/src/third_party/
               VecFor/src/tests/
               VecFor/src/third_party/
               VTKFortran/src/tests/
               VTKFortran/src/third_party/
               third_party_manual/

# main modes
[nasto-nvf-mpi-cuda]
template  = template-nvf-mpi-cuda
target    = adam_nasto_gpu.F90
build_dir = ./exe/

# templates
[template-nvf-mpi-cuda]
compiler     = nvfortran
mpi          = True
cflags       = $CSTATIC_CUDA_NVF -O2
lflags       = $LSTATIC_CUDA_NVF -O2
exclude_dirs = $EXDIRS
preproc      = -D_NVF -D_MPI_
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
colors       = True
quiet        = False
log          = True
jobs         = 4
lib_dir      = /opt/HDF5/bin/1.12.0/openmpi/3.1.5/nvidia/20.7/lib
include      = /opt/HDF5/bin/1.12.0/openmpi/3.1.5/nvidia/20.7/include
libs         = /opt/HDF5/bin/1.12.0/openmpi/3.1.5/nvidia/20.7/lib/libhdf5hl_fortran.a
               /opt/HDF5/bin/1.12.0/openmpi/3.1.5/nvidia/20.7/lib/libhdf5_hl.a
               /opt/HDF5/bin/1.12.0/openmpi/3.1.5/nvidia/20.7/lib/libhdf5_fortran.a
               /opt/HDF5/bin/1.12.0/openmpi/3.1.5/nvidia/20.7/lib/libhdf5.a
               -Wl,-rpath,/usr/lib/gcc/x86_64-linux-gnu/10 /usr/lib/gcc/x86_64-linux-gnu/10/libstdc++.so
               /opt/zlib/bin/1.2.11/lib/libz.a
               /opt/szip/bin/2.1.1/lib/libsz.a
               ./src/third_party_manual/CGAL/cgal_c_wrappers.o
               ./src/third_party_manual/memeval/cm.o
               ./src/third_party_manual/memeval/cm_wrapper.o
ext_libs     = dl m

[rule-makethirdpartymanual]
help   = Make third party manual-compiling library
rule_1 = mkdir -p exe/mod
rule_2 = cd src/third_party_manual/CGAL/ ; g++ -std=c++17 -frounding-math -O2 -I/opt/cgal/5.2.1/include/ -c cgal_c_wrappers.cpp ; cd -
rule_3 = cd src/third_party_manual/memeval/ ; gcc -c cm.c ; nvfortran -c cm_wrapper.F90 ; cd -
rule_4 = cp src/third_party_manual/memeval/*.mod exe/mod/

[rule-delexe]
help = Delete exes
rule = rm -rf exe/

[rule-clean]
help = Clean the project tree
rule_1 = FoBiS.py rule -ex delexe
