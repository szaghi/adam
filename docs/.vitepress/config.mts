        const fallback =
          md.renderer.rules[rule] ||
          ((tokens, idx) => tokens[idx].content)
        md.renderer.rules[rule] = (tokens, idx, options, env, self) => {
          const html = fallback(tokens, idx, options, env, self)
          return isApi(env) ? escapeAngles(html) : html
        }
