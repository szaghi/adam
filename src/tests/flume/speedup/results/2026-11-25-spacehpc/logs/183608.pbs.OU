job 183608.pbs 2026-11-24T22:38:27+01:00 nodes gpu-011.head.cm.local plan /lustre/projects/1026/CALCOLI/adam/speedup-133/plans/n1-b.txt
# 1 node (4 H100): the grid study (block size, load, the H100 memory ceiling; 1, 2, 4 H100) and the wg-b38 phase runs
sh mkdir -p $W && cd $SPEEDUP_DIR && cat matrix.conf grid-study-cases.conf > $W/grid-study-b.conf && mv -f $W/grid-study-b.conf $W/grid-study.conf
warmup --np 4 --cases wg-b16,wg-b20,wg-b24,wg-b28,wg-b32,wg-b36,wg-b38,wg-b48,wg-b56,wg-b64,wg-l2b48,wg-l4b12 --conf $W/grid-study.conf --work $W/grid-study
windows --np 1 --cases wg-b16,wg-b20,wg-b24,wg-b28,wg-b32,wg-b36,wg-b38,wg-b48,wg-b56,wg-b64,wg-l2b48,wg-l4b12 --conf $W/grid-study.conf --work $W/grid-study
windows --np 2 --cases wg-b16,wg-b24,wg-b38,wg-b48,wg-b64 --conf $W/grid-study.conf --work $W/grid-study
windows --np 4 --cases wg-b16,wg-b24,wg-b38,wg-b48,wg-b64 --conf $W/grid-study.conf --work $W/grid-study
analyze $W/grid-study
sh for t in n1-ib n1-noib; do mkdir -p $W/phase/$t/dumps; ln -sfn $W/grid-study/dumps/wg-b38 $W/phase/$t/dumps/wg-b38; done
ADAM_PHASE_TIMING=1 windows --np 4 --cases wg-b38 --conf $W/grid-study.conf --work $W/phase/n1-ib --exe $HOME/adam-phase/src/tests/flume/speedup/exe/fnl-nvf/adam_flume_fnl
ADAM_PHASE_TIMING=1 NOIB_EXE=$HOME/adam-phase/src/tests/flume/speedup/exe/fnl-nvf/adam_flume_fnl windows --np 4 --cases wg-b38 --conf $W/grid-study.conf --work $W/phase/n1-noib --exe $SPEEDUP_DIR/jobs/noib-exe.sh
# the ceiling: b 66 on one H100 (expected refused by the blocks budget)
warmup --np 1 --cases wg-b66 --conf $W/grid-study.conf --work $W/grid-study
