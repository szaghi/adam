#!/bin/bash
# Night 2026-11-26-i157-complete (#157 C4 on the H100): (1) the AMR ghost-fill harness of trees A (HEAD 80582712: V0 =
# the pre-C4 fill) and B (C4: V0 = the split fill, V0p = b8641a59, Ci/Cj/Kp, P1/P2 the production launches) on GPU 0,
# alternated; (2) the #133 sphere windows (2c frozen AMR, 2b runtime AMR, 2a uniform; the medooza dumps of the i157
# night) on 4 H100, FLUME executables A and B alternated run by run, 3 x (10, 110) steps.
#   qsub -q gpu4_std -l select=1:ngpus=4:ncpus=96:mpiprocs=4:mem=400gb -l place=excl -l walltime=08:00:00 sp-run.pbs
#PBS -N i157n-H100
#PBS -j oe
#PBS -o /lustre/projects/1026/CALCOLI/adam/speedup-133/i157n/
set -uo pipefail
module purge
module load nvhpc-hpcx-cuda12/26.3 python/3.11.14-cnapenc
R=/lustre/projects/1026/CALCOLI/adam/speedup-133/i157n
WIN=/lustre/projects/1026/CALCOLI/adam/speedup-133/i157/win
declare -A TREE=([A]=$HOME/adam-i157nA [B]=$HOME/adam-i157nB)
declare -A EXE=([A]=$HOME/adam-i157nA/src/tests/flume/speedup/exe/fnl-nvf/adam_flume_fnl \
                [B]=$HOME/adam-i157nB/src/tests/flume/speedup/exe/fnl-nvf/adam_flume_fnl)
declare -A COMMIT=([A]=80582712 [B]=i157n-s03)
log() { echo "$(date +%T) $*"; }
log "job $PBS_JOBID on $(hostname)"
reasons=$(nvidia-smi --query-gpu=index,clocks_event_reasons.active,enforced.power.limit,power.default_limit,memory.used --format=csv,noheader,nounits)
echo "$reasons"; bad=""
while IFS=' ,' read -r idx hex enf def used; do
   [[ $hex == 0x* ]] || continue
   (( hex & 0xCC )) && bad+=" gpu${idx}=${hex}"
   (( ${enf%.*} * 100 < ${def%.*} * 95 )) && bad+=" gpu${idx}=power-limit"
   (( ${used%.*} > 2000 )) && bad+=" gpu${idx}=busy"
done <<< "$reasons"
[[ -z $bad ]] || { echo "unhealthy GPUs:$bad" >&2 ; exit 42 ; }
for t in A B; do [[ -x ${EXE[$t]} && -x ${TREE[$t]}/exe/test_amr_ghost_bench_fnl ]] || { log "no executables in ${TREE[$t]}"; exit 3; }; done
nvidia-smi --query-gpu=timestamp,index,clocks.sm,power.draw,temperature.gpu,clocks_event_reasons.active,utilization.gpu \
   --format=csv,noheader,nounits -lms 1000 > "$R/gpustat.${PBS_JOBID%%.*}.log" 2>&1 &
POLL=$!
# (1) the harness, one GPU
mkdir -p $R/bench-work && cd $R/bench-work
{ for pair in "24 2 0.75 tricubic mean" "24 2 0.75 weno6 weno6" "24 2 0.75 quintic lagrange6" "16 2 0.5 tricubic mean" "24 3 0.5 tricubic mean"; do
    for t in A B; do
      echo "## $t $pair"
      extra="30 16.0"; [[ $pair == "24 3 0.5"* ]] && extra="20 16.0 40"
      CUDA_VISIBLE_DEVICES=0 mpirun -np 1 ${TREE[$t]}/exe/test_amr_ghost_bench_fnl $pair $extra 2>&1 | grep -E '^#|^V0|^C[a-z]|^K|^D[0-9]|^P[0-9]|differ|rror|STOP'
    done
  done; } > $R/h100-bench-${PBS_JOBID%%.*}.txt 2>&1
log "BENCH done: $R/h100-bench-${PBS_JOBID%%.*}.txt"
# (2) the sphere windows, 4 GPUs
win() { # <A|B> <case> <rep> <n> <out root>
   local tag=$1 case=$2 rep=$3 n=$4 root=$5 src d t0 t1 rc f exe launch
   src=$WIN/fnl-nvf-np4/$case; d=$root/$tag/windows/fnl-nvf-np4/$case/r$rep-n$n; exe=${EXE[$tag]}
   rm -rf "$d"; mkdir -p "$d"; cp "$src/r$rep-n$n"/*.ini "$d"/
   for f in "$src"/dump/*-restart*; do ln -s "$f" "$d"/; done
   export ADAM_SEAM_TIMING=1
   launch="mpirun -np 4 --map-by ppr:4:node --bind-to none -x PATH -x LD_LIBRARY_PATH -x ADAM_SEAM_TIMING"
   t0=$(date +%s.%N)
   ( cd "$d" && $launch "$exe" input.ini > log.txt 2>&1 < /dev/null ); rc=$?
   t1=$(date +%s.%N)
   awk -v a="$t0" -v b="$t1" 'BEGIN{printf "%.3f\n", b - a}' > "$d/wall.txt"
   grep -vE '^(date|host|slurm_job|command|exe|exe_sha256|commit|src_modified)=' "$src/r$rep-n$n/run.info" > "$d/run.info"
   printf 'date=%s\nhost=%s\nslurm_job=%s\ncommand=%s %s input.ini\nexe=%s\nexe_sha256=%s\ncommit=%s\nsrc_modified=no\nenv=\nrc=%s\n' \
      "$(date -Is)" "$(hostname)" "$PBS_JOBID" "$launch" "$exe" "$exe" "$(sha256sum "$exe" | cut -c1-16)" "${COMMIT[$tag]}" "$rc" >> "$d/run.info"
   log "$tag $case r$rep-n$n: rc $rc wall $(cat "$d/wall.txt") $(grep -a 'forest timing' "$d/log.txt" | head -1 | awk '{print $7, $8, $9, $10}')"
}
for t in A B; do mkdir -p "$R/$t"; ln -sfn /lustre/projects/1026/CALCOLI/adam/speedup-133/i157/A/cases "$R/$t/cases" 2>/dev/null; done
for c in 2c-sphere-fixed 2b-sphere-runtime 2a-sphere-uniform; do
   for rep in 1 2 3; do for n in 10 110; do for tag in A B; do win $tag $c $rep $n "$R"; done; done; done
done
kill "$POLL" 2> /dev/null
awk -F', ' '$7+0 > 0 {n[$2]++; c[$2] += $3; if (!($2 in m) || $3 < m[$2]) m[$2] = $3; if (and(strtonum($6), 0xCC)) r[$2] = $6}
   END {for (g in n) printf "gpu%s: busy %d s, SM mean %.0f min %s MHz%s\n", g, n[g], c[g]/n[g], m[g], (g in r) ? ", BRAKE " r[g] : ""}' "$R/gpustat.${PBS_JOBID%%.*}.log"
log "I157N-H100-DONE"
