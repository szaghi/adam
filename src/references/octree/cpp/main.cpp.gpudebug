#include <iostream>
#include <array>
#include <unordered_map>
#include "utils.h"
#include "geometry.h"
#include "field.h"
#include "refine.h"
#include "io_vtk.h"
#include "bc.h"
#include "immersed.h"
#include <cstdlib>

#define DEBUG_MEMORY
#include "debAlloc.h"

#ifdef USE_CUDA
#include "field_cuda.h"
#endif

#include <chrono>
using ms = std::chrono::milliseconds;
using get_time = std::chrono::steady_clock;

int main(int argc,char *argv[]){

    auto t1 = get_time::now(); 

    std::vector<int> np = {16,16,16}; // number of points
    std::vector<int> ng = {2,2,2}; // number of ghosts
    //float ls[3] = {-2.,-4.,-4.};
    //float le[3] = {6.,4.,4.};
    float ls[3] = {-1.,-2.,-2.};
    float le[3] = {3.,2.,2.};
    int forest[3] = {1,1,1};
    // Attenzione! L'interpolatore ora funziona solo se dx=dy=dz
    std::vector<std::string> bodynames = {"sphere.off"}; //, "cube2.off"};
    int itmin=0, itmax = 30, itout=10, itrefine=100, itmaxrefine=500, itstat = 5, itdeballoc=1000; 
    bool moving=false;
    Params params;
    params.ark={8./17.,17. /60.,5. /12.,3./4.}; params.brk={0.,-15./68.,-17./60.,-5./12.}; params.n_step = 4;
    params.immersion_type="advanced"; int max_it_imm=3;

    std::unordered_map<std::string,Geometry> geo_map; // all blocks
    std::unordered_map<std::string,Field> field_map; // my MPI blocks
    std::unordered_map<std::string,Polytree> immersed_map; // all MPI blocks
#ifdef USE_CUDA
    Fields_cuda fields_cuda;
#endif

    init_geo(geo_map, np, ng, ls, le, forest);

    init_field(geo_map, field_map);

    // Build immersed map
    init_immersed(immersed_map, bodynames); // get_bb(immersed_map);
    allocate_distances(immersed_map, field_map);
    compute_distances(immersed_map, field_map);

#ifdef USE_CUDA
    allocate_dev(field_map, fields_cuda, np, ng, ls, le);
#endif

    //RIMETTEREupdate_refine(geo_map, field_map, immersed_map, "force", forest); 
    update_bc_maps(geo_map, field_map, forest);
    //update_MPI(geo_map, field_map); // redistribute and update maps

    MyAllocSet(0, 0); MyAllocStat(NULL);

    auto t2 = get_time::now(); auto diff = t2 - t1; t1 = t2;
    std::cout << "Init elapsed time: " << (std::chrono::duration_cast<ms>(diff).count())/1000. << " s " << std::endl;

    //save_vtr(field_map, 0);

#ifdef USE_CUDA
    update_cpu_gpu(field_map, fields_cuda, geo_map, "cpu_to_gpu");
    update_cpu_gpu(field_map, fields_cuda, geo_map, "gpu_to_cpu");
//    exit(EXIT_FAILURE);
#endif
    params.t = 0.;
    for(int it=itmin+1;it<=itmax;it++) {
        if(it%itdeballoc == 0) {
            MyCheckAllocInUse("mem-deballoc.txt",0 ); MyAllocStat("mem-allocstat.txt");
        }

        std::cout << std::string(100, '-') << std::endl;
        std::cout << "Iteration: " << it << " t: " << params.t << " - N_blocks: " << geo_map.size() << std::endl;
        std::cout << std::string(100, '-') << std::endl;
        //params.dt = 0.00005; // min_delta = 0.03 - mu = 0.5
        //params.dt = 0.00002; // min_delta = 0.015 - mu = 0.5
        //params.dt = 0.00004; // min_delta = 0.015 - mu = 0.2
        //params.dt = 0.00002; // min_delta = 0.01 - mu = 0.2 - refine=7
        //params.dt = 0.00004; // min_delta = 0.015 - mu = 0.2 - refine=6
        //params.dt = 0.00004; 
        params.dt = 0.002; 
        if(it%itrefine == 0 && it < itmaxrefine) {
//#ifdef USE_CUDA
//            update_cpu_gpu(field_map, geo_map, "gpu_to_cpu");
//#endif
            update_refine(geo_map, field_map, immersed_map, "mark", forest); 
            update_bc_maps(geo_map, field_map, forest);
            //update_MPI(geo_map, field_map); // redistribute and update maps
//#ifdef USE_CUDA
//            update_cpu_gpu(field_map, geo_map, "cpu_to_gpu");
//#endif
        }

        for(params.n=0;params.n<params.n_step;(params.n)++) {
            params.t=params.t+params.dt*(params.ark[params.n]+params.brk[params.n]);
            std::cout << "RK-Iteration: " << it << " t: " << params.t << " n: " << params.n << std::endl;

#ifdef USE_CUDA
            update_cpu_gpu(field_map, fields_cuda, geo_map, "cpu_to_gpu");
            prhs_compute_dev(fields_cuda, params);
            update_cpu_gpu(field_map, fields_cuda, geo_map, "gpu_to_cpu");
#else
            prhs_compute(geo_map, field_map, params);
#endif

            if(moving) {
                std::array<float,3> transl_amount = {0.02,0.0,0.0};
                move_immersed("translate", transl_amount, immersed_map, "cube.off");
                // andrebbe deallocata e allocata roba se muovendosi l'oggetto interagisce con blocchi diversi
                compute_distances(immersed_map, field_map); 
            }

            //update_MPI(geo_map, field_map); // redistribute and update maps
            
#ifdef USE_CUDA
            update_cpu_gpu(field_map, fields_cuda, geo_map, "cpu_to_gpu");
            update_bc_dev(geo_map, field_map, fields_cuda);
            update_cpu_gpu(field_map, fields_cuda, geo_map, "gpu_to_cpu");
#else
            update_bc(geo_map, field_map);
#endif

            if(params.immersion_type == "simple") {
                std::cout << "immersion type simple" << std::endl;
                set_simple_immerse(geo_map, field_map, params);
            } else if(params.immersion_type == "advanced") {
#ifdef USE_CUDA
                update_cpu_gpu(field_map, fields_cuda, geo_map, "cpu_to_gpu");
                correct_advanced_immerse_dev(fields_cuda, params);
                update_cpu_gpu(field_map, fields_cuda, geo_map, "gpu_to_cpu");
#else
                correct_advanced_immerse(geo_map, field_map);
#endif
                for(int it_imm=0;it_imm<max_it_imm;it_imm++) {
#ifdef USE_CUDA
                    update_cpu_gpu(field_map, fields_cuda, geo_map, "cpu_to_gpu");
                    evolve_advanced_immerse_dev(fields_cuda, params);
                    update_cpu_gpu(field_map, fields_cuda, geo_map, "gpu_to_cpu");
#else
                    evolve_advanced_immerse(geo_map, field_map);
#endif
#ifdef USE_CUDA
                    update_cpu_gpu(field_map, fields_cuda, geo_map, "cpu_to_gpu");
                    update_bc_dev(geo_map, field_map, fields_cuda);
                    update_cpu_gpu(field_map, fields_cuda, geo_map, "gpu_to_cpu");
#else
                    update_bc(geo_map, field_map);
#endif
                }
#ifdef USE_CUDA
                update_cpu_gpu(field_map, fields_cuda, geo_map, "cpu_to_gpu");
                correct_advanced_immerse_dev(fields_cuda, params);
                update_cpu_gpu(field_map, fields_cuda, geo_map, "gpu_to_cpu");
#else
                correct_advanced_immerse(geo_map, field_map);
#endif
            }

#ifdef USE_CUDA
            update_cpu_gpu(field_map, fields_cuda, geo_map, "cpu_to_gpu");
            rhs_compute_dev(fields_cuda, params);
            update_cpu_gpu(field_map, fields_cuda, geo_map, "gpu_to_cpu");
#else
            rhs_compute(geo_map, field_map, params);
#endif

#ifdef USE_CUDA
            update_cpu_gpu(field_map, fields_cuda, geo_map, "cpu_to_gpu");
            linear_compute_dev(fields_cuda, params);
            update_cpu_gpu(field_map, fields_cuda, geo_map, "gpu_to_cpu");
#else
            linear_compute(geo_map, field_map, params);
#endif
//#ifdef USE_CUDA
//            update_cpu_gpu(field_map, fields_cuda, geo_map, "gpu_to_cpu");
//#endif
        }
        //if(it%itstat==0) {
        //    fix_edge_and_corners(field_map);
        //    compute_forces(it, geo_map, field_map, immersed_map, params);
        //    compute_totalforces(it, geo_map, field_map, params);
        //}
        if(it%itout==0) {
//#ifdef USE_CUDA
//            update_cpu_gpu(field_map, geo_map, "gpu_to_cpu");
//#endif
            save_vtr(field_map, it);
        }

        t2 = get_time::now(); diff = t2 - t1; t1 = t2;
        std::cout << "Iteration " << it << " N blocks: " << geo_map.size() << " elapsed time: " << 
            (std::chrono::duration_cast<ms>(diff).count())/1000. << " s " << std::endl;
    }

}
