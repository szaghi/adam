   call self%file_input%get(section_name='solids', option_name='n_solids', val=self%n_solids)
   do i_solid=1,self%n_solids
      sname = 'solid_'//trim(str(i_solid,.true.))
      call self%file_input%get(section_name=sname, option_name='var', val=self%amr_marker(i_marker)%var)

      [ 2.0 3.0 5.0 | 3.0 4.0 ]

      cp             = closest_patch(i,j,k)
      bcs            = bcs_array(cp)
      i_bc_var_start = i_bc_var_start_array(cp)
      i_bc_var_end   = i_bc_var_end_array(cp)
      bcs_vars       = bcs_vars_array(i_bc_var_start:i_bc_var_end)
   enddo


   do k=1,nk
   do j=1,nj
   do i=1,ni
   do b=1,blocks_number

   do i_solid=1,self%n_solids
      ! Compute distance
      distance = ...
      ! Give sign based on inside/outside and internal/external
      distance = +/- distance
      ! 
      if(abs(distance) < min_abs_distance) then
         closest_solid(i,j,k,b) = i_solid
         phi(i,j,k,b)           = distance
      endif
      
   enddo

   n_patches = n_patches_array(closest_solid(i,j,k,b))
   do i_patch=1,n_patches
      ! Compute distance
      distance_patch = ...
      if(abs(distance_patch) < min_abs_distance_patch) then
          closest_patch(i,j,k,b) = i_patch
      endif
   enddo

   enddo
   enddo
   enddo
   enddo

   phi_gpu           = phi
   closest_patch_gpu = closest_patch


   bcs_type      = bcs_type_array(closest_patch_gpu(i,j,k,b))
   i_bc_var_start = i_bc_var_start_array(cp)
   i_bc_var_end   = i_bc_var_end_array(cp)
   bcs_vars      = bcs_vars_array(i_bc_var_start:i_bc_var_end)

